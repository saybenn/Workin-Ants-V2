    "P0C-INSTALL-01": {
      "id": "P0C-INSTALL-01",
      "phase": "P0-C",
      "stage": "F0_FOUNDATION",
      "requirement": [
        "DBP-06",
        "DBP-10"
      ],
      "setup": "Approved immutable SQL history and captured disposable identity; empty application state, provider-managed stand-ins explicitly listed",
      "action": "Apply only selected F0 history with dedicated migrator, then apply again",
      "expected": "First deploy completes; second deploy has zero pending work and unchanged applied checksums",
      "status": "NOT_RUN",
      "p0c03a_vectors": [
        {
          "id": "INSTALL-CLEANUP",
          "positive": "Bootstrap/application succeeds, then ORIGINAL grantor runs finalize in a separate connection",
          "adversarial": "Inject application rollback, then the same grantor finalizes; wrong grantor cannot clean up",
          "expected": "Both outcomes leave zero helper/verifier memberships on schema owner and zero CREATE on platform_private for leaf roles; runtime credentials stay inactive until verified",
          "status": "NOT_RUN"
        },
        {
          "id": "FUNCTION-ACL-AUTHORITY",
          "positive": "Install as actual wa_migrator, SET LOCAL ROLE wa_schema_owner; exact function grants and managed-role revocations precede every transfer to NOINHERIT leaf owners",
          "adversarial": "Move a grant/revocation after transfer without SET ROLE actual owner",
          "expected": "Install commits with expected ACL; original grantor then removes every temporary membership and CREATE privilege",
          "status": "NOT_RUN"
        }
      ]
    },
    "P0C-INSTALL-02": {
      "id": "P0C-INSTALL-02",
      "phase": "P0-C",
      "stage": "F0_FOUNDATION",
      "requirement": [
        "DBP-10"
      ],
      "setup": "Disposable clone only; injected failure before initial transactional migration COMMIT",
      "action": "Run approved failed migration, inspect app catalog/ledger and perform reviewed rollback/forward-repair procedure",
      "expected": "Failure is nonzero and not accepted; app transaction rolled back; ledger failure preserved until actual verified repair",
      "status": "NOT_RUN",
      "p0c03a_vectors": [
        {
          "id": "FUNCTION-ACL-FAILURE-CLEANUP",
          "positive": "Original grantor finalizes after application ROLLBACK as well as COMMIT",
          "adversarial": "Inject a failure after function setup but before application COMMIT; attempt runtime activation before independent cleanup verification",
          "expected": "No application objects survive failed application transaction; zero temporary memberships/leaf CREATE after separate finalization",
          "status": "NOT_RUN"
        }
      ]
    }
  },

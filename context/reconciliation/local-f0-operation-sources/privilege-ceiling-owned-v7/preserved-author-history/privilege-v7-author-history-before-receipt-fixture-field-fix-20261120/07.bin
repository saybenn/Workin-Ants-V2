class PrivilegeResourceMountV2SafetyCompositionTests(unittest.TestCase):
    setUp=COMMON.setUp
    fixture=fixture
    writes_fail=COMMON.writes_fail
    selectors=COMMON.selectors
    safe=COMMON.safe

    def test_actual_provider_paths_close_globally_on_malformed_command_or_IO_stop(self):
        for function in ('provider_preinstall','provider_authentication','provider_postinstall'):
            for io_failure in (False,True):
                with self.subTest(function=function,io_failure=io_failure):
                    n,w,p,*_=self.fixture();n['PRIVILEGE_NATIVE']['preinstall_observed']=True
                    n['finalized'].add('first');n['report']['targets']['first']['finalization']='PASS'
                    original=w.command
                    def command(args,input=None,timeout=60):
                        if n['report']['stage'] in n['_SAFETY_SQL_LABELS'].values():return original(args,input,timeout)
                        self.assertIn('psql',args);self.assertEqual(args[args.index('-h')+1],'127.0.0.1')
                        w.trace.append({'selector':'PROVIDER_NORMAL','timeout':timeout})
                        return w.result(stdout=CANARY)
                    n['command']=command
                    if io_failure:self.writes_fail(n,w,mode='post')
                    call=() if function=='provider_preinstall' else ('first',{'status':'CLI_COMPLETED_REQUIRES_INDEPENDENT_LEDGER_CATALOG_CHECKS','exit_code':0}) if function=='provider_postinstall' else ('first',)
                    with self.assertRaises(BaseException),redirect_stdout(io.StringIO()):n[function](*call)
                    self.assertEqual(self.selectors(w)[-1],'GLOBAL_BACKENDS')
                    self.assertNotIn('postinstall_observed',n['PRIVILEGE_NATIVE']);self.safe(n)

    def test_actual_functions_are_embedded_not_template_injected(self):
        n,w,p,*_=self.fixture()
        core=TASK/'execute_local_f0_privilege_ceiling_v7_20261120.py'
        steps=TASK/'local_f0_privilege_ceiling_v7_operation_steps.py'
        for key in ('finalize','closed_backends','_required_zero_backends','_required_safety_sql','sql','observe'):
            self.assertEqual(Path(n[key].__code__.co_filename),core)
        self.assertEqual(Path(n['main'].__code__.co_filename),steps)
        self.assertNotIn('closed_backends',{x.name for x in ast.parse(steps.read_bytes()).body if isinstance(x,ast.FunctionDef)})

    def test_actual_catalog_operation_closes_after_ordinary_postwrite_failure(self):
        n,w,p,*_=self.fixture();self.writes_fail(n,w,mode='post')
        with self.assertRaises(OSError),redirect_stdout(io.StringIO()):
            n['run_catalog_query']('first','SELECT 1;','ACTUAL_CATALOG_QUERY')
        self.assertEqual(self.selectors(w),['NORMAL','GLOBAL_BACKENDS'])
        self.assertFalse(n['_required_safety_evidence_complete']());self.safe(n)

    def test_actual_owner_finalizer_and_original_sql_recipe_are_exact(self):
        n,w,p,*_=self.fixture();old=TASK/'safety-sql-before-author-20261119/execute_local_f0_owner_read_20261118_finally_v2.py'
        before=ast.parse(old.read_bytes());after=ast.parse((TASK/'execute_local_f0_privilege_ceiling_v7_20261120.py').read_bytes())
        for key in ('sql','observe','psql_args','cleanup'):
            self.assertEqual(ast.dump(next(x for x in before.body if isinstance(x,ast.FunctionDef) and x.name==key),include_attributes=False),ast.dump(next(x for x in after.body if isinstance(x,ast.FunctionDef) and x.name==key),include_attributes=False))
        with redirect_stdout(io.StringIO()):n['finalize']('first')
        self.assertEqual(self.selectors(w),['FINALIZATION_BACKENDS','ORIGINAL_GRANTOR_FINALIZATION','FINALIZATION_RESULT'])
        self.assertEqual(w.trace[1]['sql_sha256'],hashlib.sha256(p.read_bytes()).hexdigest())

# Reuse the reviewed adversarial vectors, but with the actual Owner fixture
# above and a single explicit Owner profile. No helper bodies are recompiled.
selected=(
 'test_real_finalizers_all_five_profiles_execute_pre_revoke_post_under_persistent_io',
 'test_pre_post_write_and_event_failure_each_preserve_actual_safety_order',
 'test_global_closure_real_sql_still_runs_then_public_barrier_blocks_normal_continuation',
 'test_normal_sql_and_observe_are_unchanged_and_still_stop_before_command',
 'test_invalid_or_active_precondition_never_dispatches_original_finalizer',
 'test_nonzero_unknown_or_malformed_command_response_blocks_revoke',
 'test_missing_drifted_unadmitted_or_symlink_source_blocks_finalizer_and_still_observes_post',
 'test_source_recipe_preservation_and_foreign_profile_target_selector_are_closed',
 'test_first_command_stop_survives_post_observer_stop',
 'test_original_operation_stop_survives_nested_closure_persistence_error',
 'test_actual_owning_mains_only_command_mock_still_finalize_and_remove_all_owned_resources',
 'test_clean_success_all_profiles_and_no_io_error_permits_normal_continuation',
 'test_timeout_and_command_stop_preserve_first_failure_and_never_qualify_cleanup',
 'test_post_observer_strict_identity_shape_and_authority_never_get_promoted',
 'test_owner_original_stop_is_preserved_before_its_distinct_failure_bookkeeping',
 'test_existing_original_primary_survives_later_finalizer_and_post_failures_all_profiles',
 'test_ordinary_finalizer_exit3_retains_clean_or_dirty_safe_poststate_as_unqualified_all_profiles',
 'test_source_failure_retains_only_validated_post_and_preserves_recorded_primary_all_profiles',
 'test_existing_primary_survives_nested_closure_failure_all_profiles',
 'test_fixed_finalizer_missing_nonregular_and_regular_paths_keep_exact_source_gate',
)
for key in selected:
    source=textwrap.dedent(inspect.getsource(getattr(COMMON,key)))
    source=source.replace("('lease','restore','native','owner','install')","('owner',)").replace("self.fixture('lease')","self.fixture('owner')")
    source=source.replace("n['record_failure'](error.exception.stage,error.exception.code,primary=True)","n['_required_safety_first_exception'](error.exception)")
    if key=='test_normal_sql_and_observe_are_unchanged_and_still_stop_before_command':
        source=source.replace("self.assertFalse(n['_required_safety_evidence_complete']());",'')
    namespace={};exec(compile(source,str(Path(__file__)),'exec'),globals(),namespace)
    setattr(PrivilegeResourceMountV2SafetyCompositionTests,key,namespace[key])

del COMMON



def v7_isolated_review_fixture(task, root):
    assert task.resolve().is_relative_to(TASK.resolve()) and not root.resolve().is_relative_to(ROOT.resolve())
    namespace=runpy.run_path(str(root/CLOSURE_COOR))
    source4={name:sha((root/name).read_bytes())for name in(namespace['SELF'],namespace['PROTOCOL'],namespace['METADATA_TEST'],namespace['METADATA_DOC'])}
    names=(CLOSURE_CORE,CLOSURE_STEPS,CLOSURE_PREP,CLOSURE_CHECK,CLOSURE_PIN)
    five={name:sha((task/name).read_bytes())for name in names}
    child_name='context/reconciliation/privilege-ceiling-v7-source-validation.json'
    child=json.loads((root/child_name).read_bytes());owned=json.loads((root/CLOSURE_REVIEW).read_bytes())
    gates=[]
    for actor in('peer','Root'):
        relative='context/reconciliation/local-f0-operation-sources/privilege-ceiling-owned-v7/reviews/OFFLINE_TEST_ONLY_'+actor+'.json'
        value={'decision':'SOURCE_APPROVED','source4_sha256':source4,'operator_sources_sha256':five,'scope':'PRIVATE_OFFLINE_METADATA_PROJECTION_NOT_RUNTIME_AUTHORITY'}
        target=root/relative;target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(encoded(value))
        gates.append({'decision':'SOURCE_APPROVED','path':relative,'sha256':sha(target.read_bytes()),'source4_sha256':source4,'operator_sources_sha256':five})
    child.update(review_gate='SOURCE_APPROVED',source4_sha256=source4,independent_source_review=gates[0],Root_source_review=gates[1])
    (root/child_name).write_bytes(encoded(child))
    owned.update(operator_sources_sha256=five,independent_safety_sql_review=gates[0],independent_projection_review=gates[0],Root_source_review=gates[1],corrected_child_validation={'path':child_name,'sha256':sha((root/child_name).read_bytes())})
    archive=root/'context/reconciliation/local-f0-operation-sources/privilege-ceiling-owned-v7'
    owned['archive_files_sha256']={p.relative_to(root).as_posix():sha(p.read_bytes())for p in archive.rglob('*')if p.is_file()}
    (root/CLOSURE_REVIEW).write_bytes(encoded(owned))
    return child,owned


class V7ClosedReferenceTests(PrivilegeOperationTests):
 def test_V7_closed_reader_rejects_duplicate_nonfinite_extra_bytes_and_alias(self):
  n=self.n;fixed=n['OUT']/'privilege-ceiling-component/privilege-ceiling-results.json';fixed.parent.mkdir(parents=True)
  ref=lambda:{'artifact':'privilege-ceiling-component/privilege-ceiling-results.json','present':None,'read_status':'UNAVAILABLE'}
  fixed.write_bytes(b'{"source":"closed"}')
  value=n['privilege_read_closed_reference'](ref());self.assertEqual(value,{'source':'closed'})
  for raw in(b'{"a":1,"a":2}',b'{"a":NaN}',b'{} EXTRA'):
   fixed.write_bytes(raw)
   with self.assertRaises((n['Stop'],ValueError)):n['privilege_read_closed_reference'](ref())
  with self.assertRaises(n['Stop']):n['privilege_read_closed_reference']({'artifact':'../other'})

 def test_V7_two_closed_reads_detect_real_same_size_write_with_restored_mtime(self):
  import os
  n=self.n;fixed=n['OUT']/'privilege-ceiling-component/privilege-ceiling-results.json';fixed.parent.mkdir(parents=True);fixed.write_bytes(b'{"value":1}')
  original=Path.open;metadata=fixed.stat();calls=[]
  class Reader:
   def __init__(self,stream):self.stream=stream
   def __enter__(self):self.stream.__enter__();return self
   def __exit__(self,*args):return self.stream.__exit__(*args)
   def fileno(self):return self.stream.fileno()
   def read(self,count):
    data=self.stream.read(count);calls.append(True)
    if len(calls)==1:
     with original(fixed,'wb')as target:target.write(b'{"value":2}')
     os.utime(fixed,ns=(metadata.st_atime_ns,metadata.st_mtime_ns))
    return data
  def opened(path,*args,**kwargs):
   stream=original(path,*args,**kwargs)
   return Reader(stream)if path==fixed and args and args[0]=='rb'else stream
  reference={'artifact':'privilege-ceiling-component/privilege-ceiling-results.json','present':None,'read_status':'UNAVAILABLE'}
  with patch.object(Path,'open',opened),self.assertRaises(n['Stop']):n['privilege_read_closed_reference'](reference)
  self.assertFalse(reference['closed_recheck_match']);self.assertNotIn(CANARY,json.dumps(reference))

 def test_V7_fresh_barrier_rejects_late_mutation_and_retains_original_hash(self):
  n=self.n;fixed=n['OUT']/'privilege-ceiling-component/privilege-ceiling-results.json';fixed.parent.mkdir(parents=True);fixed.write_bytes(b'{"value":1}')
  reference={'artifact':'privilege-ceiling-component/privilege-ceiling-results.json','present':None,'read_status':'UNAVAILABLE'}
  n['privilege_read_closed_reference'](reference);expected=reference['artifact_sha256'];fixed.write_bytes(b'{"value":2}')
  with self.assertRaises(n['Stop']):n['privilege_reference_integrity_barrier'](reference)
  self.assertEqual(reference['artifact_sha256'],expected);self.assertFalse(reference['integrity_recheck_match'])



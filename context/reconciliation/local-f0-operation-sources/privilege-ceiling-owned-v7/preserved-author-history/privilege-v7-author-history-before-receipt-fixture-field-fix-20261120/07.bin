 if _method.startswith('test_'):setattr(V7ClosedReferenceTests,_method,None)

class V7SourceGateTests(PrivilegeMetadataV6ClosureTests):
 def setUp(self):
  self.directory=Path(tempfile.mkdtemp(prefix='v7-gate-',dir=self.task));self.addCleanup(lambda:shutil.rmtree(self.directory))

 def entry_with_metadata(self,changed):
  m=deepcopy(self.pinned);m['review_status']='APPROVED_LOCAL_F0_PRIVILEGE_CEILING_ATTEMPT';m['evidence_directory']=str(self.directory/'NEVER_CREATED')
  for relative,raw in changed.items():m['packet_files_sha256'][relative]=sha(raw)
  m['packet_sha256']=aggregate(m['packet_files_sha256']);path=self.directory/'operation-manifest.json';path.write_bytes(encoded(m))
  module=runpy.run_path(str(self.task/CLOSURE_CORE));actual_read=Path.read_bytes;actual_compile=compile;helpers=[];processes=[];output=io.StringIO()
  def read(p):return changed[p.relative_to(self.root).as_posix()]if p.is_relative_to(self.root)and p.relative_to(self.root).as_posix()in changed else actual_read(p)
  def compile_(source,filename,*args,**kw):
   if str(filename).startswith(str(self.root/'scripts')):helpers.append(str(filename))
   return actual_compile(source,filename,*args,**kw)
  def process(*args,**kw):processes.append(True);raise AssertionError('PROCESS_FORBIDDEN_PENDING_GATE')
  with patch.object(Path,'read_bytes',read),patch('builtins.compile',compile_),patch.object(subprocess,'run',side_effect=process),redirect_stdout(output):
   code=module['launch'](['--execute-reviewed-privilege-ceilings','--manifest',str(path)])
  self.assertEqual(code,1);self.assertEqual(helpers,[]);self.assertEqual(processes,[]);self.assertFalse(Path(m['evidence_directory']).exists());self.assertNotIn(CLOSURE_CANARY,output.getvalue())

 def test_V7_actual_entry_all_new_PENDING_gates_before_helpers_processes_OUT(self):
  child='context/reconciliation/privilege-ceiling-v7-source-validation.json'
  for relative,key in((child,'review_gate'),(child,'independent_source_review'),(child,'Root_source_review'),(CLOSURE_REVIEW,'independent_projection_review'),(CLOSURE_REVIEW,'Root_source_review')):
   value=json.loads((self.root/relative).read_bytes())
   if key=='review_gate':value[key]='PENDING'
   else:value[key]['decision']='PENDING'
   with self.subTest(key=key,relative=relative):self.entry_with_metadata({relative:encoded(value)})

 def test_V7_actual_entry_missing_maps_fake_review_bytes_duplicate_nonfinite_refused(self):
  child='context/reconciliation/privilege-ceiling-v7-source-validation.json';original=json.loads((self.root/child).read_bytes());variants=[]
  for field in('source4_sha256','independent_source_review'):
   value=deepcopy(original);value.pop(field);variants.append(encoded(value))
  value=deepcopy(original);value['independent_source_review']['sha256']='f'*64;variants.append(encoded(value))
  value=deepcopy(original);value['independent_source_review']['source4_sha256']={};variants.append(encoded(value))
  variants.extend((b'{"review_gate":"PENDING",'+encoded(original)[1:],b'{"probe":NaN,'+encoded(original)[1:]))
  for index,raw in enumerate(variants):
   with self.subTest(vector=index):self.entry_with_metadata({child:raw})

 def test_V7_preparer_review_JSON_refuses_duplicate_and_nonfinite(self):
  for raw in(b'{"decision":"PENDING","decision":"SOURCE_APPROVED"}',b'{"decision":NaN}',b'{"decision":Infinity}'):
   with self.assertRaises(self.preparer['Refused']):self.preparer['review_json'](raw)

class V7ReceiptTypeTests(PrivilegeOperationTests):
 def test_V7_actual_receipt_parent_contract_rejects_every_missing_extra_or_wrong_type(self):
  n=self.n;protocol=runpy.run_path(str(ROOT/'scripts/privilege_ceiling_control_protocol_v7.py'));fixtures=json.loads((ROOT/'review-output/privilege-ceiling-control-rehearsal/fixtures.json').read_bytes())
  case=next(c for c in fixtures['cases']if c['name']=='CREATE-wa_app_runtime-app');template=(ROOT/'review-output/privilege-ceiling-control-rehearsal'/case['sql']).read_text();text=protocol['reviewed_text'](template,RUN)
  binding=protocol['create_projection_binding'](case,template,text,RUN);identity={'template_sha256':case['sql_sha256'],'rendered_source_sha256':sha(text.encode())}
  _,receipt=protocol['diagnostic_with_receipt']('ERROR:  42501: permission denied for schema app\nLOCATION:  aclcheck_error, aclchk.c:2841\n',case['diagnostic'],{'schema_create':False},text,protocol['source_position_matches'],create_binding=binding,source_identity=identity)
  operation={'executed_sql_sha256':identity['rendered_source_sha256']};self.assertTrue(n['privilege_match_receipt_allowed'](receipt,operation,case))
  for key in receipt:
   for mutant in({k:v for k,v in receipt.items()if k!=key},{**receipt,key:1},{**receipt,key:CANARY}):self.assertFalse(n['privilege_match_receipt_allowed'](mutant,operation,case),key)
  self.assertFalse(n['privilege_match_receipt_allowed']({**receipt,'extra':True},operation,case))


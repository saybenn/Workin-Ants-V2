        self.assertEqual(self.pins[CLOSURE_README], '5837f26cd959ee0addca42f319b3d67f8d8ee09828657dd793c6caeadbd416ec')
        self.assertTrue(all((self.pins[p] == h == sha((self.root / p).read_bytes()) for p, h in artifacts.items())))
        self.assertEqual(self.master['privilege_ceiling']['fixtures_sha256'], '4ebe8b6cd7b85ff5ad8dbb79d431bb7001cf16dea72e3920138be4b5f2855e68')
        self.assertEqual(self.master['privilege_ceiling']['content_sha256'], '643232e4d068892b49e49122b7ce3b909bd86caa9e770aa923d7df00def1ec32')

    def test_real_unchanged_load_inputs_accepts_only_the_actual_prepare_map(self):
        before = encoded(self.component['packet_files_sha256'])
        loaded = self.M['load_inputs'](self.component)
        self.assertEqual(encoded(self.component['packet_files_sha256']), before)
        self.assertEqual(loaded[0], json.loads((self.root / CLOSURE_PACKET / 'fixtures.json').read_bytes()))
        self.assertEqual(set(loaded[1]), set(self.pins))
        self.assertEqual(len(loaded[0]['cases']), 200)


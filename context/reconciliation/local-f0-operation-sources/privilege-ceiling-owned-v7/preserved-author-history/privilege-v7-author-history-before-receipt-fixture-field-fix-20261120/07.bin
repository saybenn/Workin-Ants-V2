# Real source-entry tests: AST Name-only isolation preserves dictionary/file keys.
"""PersonSubjectV5: actual preparation map, real source loader, all processes mocked.
No plans() pin factory is used. Synthetic native assets are offline-only.
"""
from pathlib import Path
from copy import deepcopy
from contextlib import ExitStack, redirect_stdout, redirect_stderr
from unittest.mock import patch, Mock
from types import SimpleNamespace
import ast, hashlib, io, json, runpy, shutil, socket, subprocess, sys, tempfile, unittest, uuid
TASK = Path(__file__).resolve().parent
ROOT = TASK / 'workinants-correction-pass'
CLOSURE_CORE = 'execute_local_f0_privilege_ceiling_v7_20261120.py'
CLOSURE_STEPS = 'local_f0_privilege_ceiling_v7_operation_steps.py'
CLOSURE_PREP = 'prepare_local_f0_privilege_ceiling_v7_plan.py'
CLOSURE_PIN = 'pin_local_f0_privilege_ceiling_v7_plan_20261120.py'
CLOSURE_CHECK = 'check_local_f0_privilege_ceiling_v7_operation.py'
CLOSURE_COOR = 'scripts/sql-review/run-privilege-ceiling-control-rehearsal-v7.py'
CLOSURE_REVIEW = 'context/reconciliation/local-f0-privilege-ceiling-owned-v7-source-validation.json'
CLOSURE_PACKET = 'review-output/privilege-ceiling-control-rehearsal'
CLOSURE_README = CLOSURE_PACKET + '/README.md'
CLOSURE_BASE = TASK / 'local-f0-catalog-v4-plan-23bd8979/operation-manifest.json'
sha = lambda raw: hashlib.sha256(raw).hexdigest()
aggregate = lambda m: sha(''.join((k + '\x00' + m[k] + '\n' for k in sorted(m))).encode())
encoded = lambda v: (json.dumps(v, indent=2) + '\n').encode()
CLOSURE_CANARY = 'SECRET_CANARY_ADMISSION_MUST_NEVER_EXPORT'

class PrivilegeMetadataV6ClosureTests(unittest.TestCase):

    @classmethod
    def setUpClass(cls):
        cls.guard = ExitStack()
        cls.addClassCleanup(cls.guard.close)
        for name in ('run', 'Popen', 'call', 'check_call', 'check_output'):
            cls.guard.enter_context(patch.object(subprocess, name, side_effect=AssertionError('REAL_PROCESS_FORBIDDEN')))
        for owner, name in ((socket, 'create_connection'), (socket.socket, 'connect')):
            cls.guard.enter_context(patch.object(owner, name, side_effect=AssertionError('NETWORK_FORBIDDEN')))
        cls.temporary = tempfile.TemporaryDirectory(prefix='priv-admission-v4-', dir=TASK)
        cls.addClassCleanup(cls.temporary.cleanup)
        cls.task = Path(cls.temporary.name)
        cls.root = cls.task / 'workinants-correction-pass'
        cls.root.mkdir()
        # Clone first: the real V7 production gates correctly stay PENDING.
        # Only this private offline metadata fixture receives projected reviews.
        old = json.loads((TASK / 'local-f0-privilege-ceiling-plan-086c453e/operation-manifest.json').read_bytes())
        current = json.loads((ROOT / CLOSURE_REVIEW).read_bytes())
        names = set(old['packet_files_sha256']) | set(current['archive_files_sha256']) | {CLOSURE_REVIEW, 'context/reconciliation/privilege-ceiling-v7-source-validation.json'}
        names.update(('scripts/privilege_ceiling_control_protocol_v7.py', CLOSURE_COOR, 'scripts/sql-review/test_run_privilege_ceiling_control_rehearsal_v7.py', 'scripts/sql-review/PRIVILEGE-CEILING-CONTROL-REHEARSAL-V7.md'))
        cls.actual_inventory = {relative: sha((ROOT / relative).read_bytes()) for relative in names}
        for relative in names:
            dest = cls.root / relative
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_bytes((ROOT / relative).read_bytes())
        for name in (CLOSURE_CORE, CLOSURE_STEPS, CLOSURE_PREP, CLOSURE_PIN, CLOSURE_CHECK):
            (cls.task / name).write_bytes((TASK / name).read_bytes())
        for relative in ('node_modules/@prisma/engines-version/package.json', 'node_modules/prisma/package.json'):
            target = cls.root / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes((ROOT / relative).read_bytes())
        # Offline SQL transport model only, not a production import/admission.
        relative='scripts/sql-review/test_run_native_table_denials_v3.py'
        target=cls.root/relative;target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes((ROOT/relative).read_bytes())
        v7_isolated_review_fixture(cls.task, cls.root)
        value = json.loads((cls.root / CLOSURE_REVIEW).read_bytes())
        value['independent_safety_sql_review'] = {'decision': 'SOURCE_APPROVED', 'scope': 'OFFLINE_TEST_ONLY_SYNTHETIC_FUTURE_APPROVAL_NOT_RUNTIME_AUTHORITY'}
        (cls.root / CLOSURE_REVIEW).write_bytes(encoded(value))
        cls.baseline = cls.task / 'offline-baseline.json'
        cls.baseline.write_bytes(CLOSURE_BASE.read_bytes())
        cls.legacy = runpy.run_path(str(ROOT / 'scripts/sql-review/test_run_privilege_ceiling_control_rehearsal_v7.py'))
        cls.preparer = runpy.run_path(str(cls.task / CLOSURE_PREP))
        cls.M = runpy.run_path(str(cls.root / CLOSURE_COOR))
        result = cls.preparer['prepare'](cls.baseline, sha(cls.baseline.read_bytes()), cls.legacy['RUN'])
        cls.plan_path = Path(result['operation_manifest'])
        cls.unpinned = cls.plan_path.read_bytes()
        cls.master = json.loads(cls.unpinned)
        cls.pins = deepcopy(cls.master['prepared_source_file_inventory_sha256'])
        cls.target = json.loads(Path(cls.master['migration_targets']['ok']['manifest_path']).read_bytes())
        cls.pinner = runpy.run_path(str(TASK / CLOSURE_PIN))
        cls.pinner['pin'].__globals__['ROOT'] = cls.root
        cls.pin_calls = []

        def git(*args, input=None):
            cls.pin_calls.append(args)
            if args == ('rev-parse', 'HEAD'):
                return b'a' * 40 + b'\n'
            if args == ('rev-parse', 'HEAD^{tree}'):
                return b'b' * 40 + b'\n'
            assert args == ('cat-file', '--batch')
            output = b''
            for request in input.decode().splitlines():
                commit, relative = request.split(':', 1)
                assert commit == 'a' * 40
                raw = (cls.root / relative).read_bytes()
                output += b'0' * 40 + b' blob ' + str(len(raw)).encode() + b'\n' + raw + b'\n'
            return output
        cls.pinner['pin'].__globals__['git_read'] = git
        cls.pin_result = cls.pinner['pin'](cls.plan_path)
        cls.pinned = json.loads(cls.plan_path.read_bytes())
        assert cls.pinned['packet_files_sha256'] == cls.pins
        cls.current_validation = sha((ROOT / CLOSURE_REVIEW).read_bytes())

    @classmethod
    def tearDownClass(cls):
        try:
            assert cls.task.resolve().parent == TASK.resolve() and (not cls.task.is_relative_to(ROOT))
            cls.temporary.cleanup()
        finally:
            cls.guard.close()

    def setUp(self):
        self.directory = Path(tempfile.mkdtemp(prefix='case-', dir=self.task))
        self.addCleanup(lambda: shutil.rmtree(self.directory))
        self.world = self.legacy['World']()
        self.world.target = deepcopy(self.target)
        self.world.native = json.loads((ROOT / 'context/reconciliation/local-f0-run-assets/c820e39-privilege-53d7f860/evidence/native-before.json').read_bytes())
        target = self.target['target']
        self.world.container['Name'] = '/' + target['container_name']
        self.world.container['Config']['Image'] = target['image']
        self.world.volume['Name'] = target['volume_name']
        for mount in self.world.container['Mounts']:
            if mount['Type'] == 'volume':
                mount['Name'] = target['volume_name']
            elif mount['Type'] == 'bind':
                mount['Source'] = target['bootstrap_secret_host_path']
        self.component = self.component_plan(self.pins)

    def component_plan(self, pins):
        M = self.M
        N = self.legacy['N']
        world = self.world
        run = self.master['run_id']
        cid = self.legacy['CID']

        def asset(name, value):
            path = self.directory / (name + '.json')
            path.write_bytes(encoded(value))
            return {'path': str(path), 'sha256': sha(path.read_bytes())}
        comparison = json.loads((ROOT / 'context/reconciliation/local-f0-run-assets/c820e39-privilege-53d7f860/evidence/catalog-comparison.json').read_bytes())
        self.assertEqual(comparison['check_counts'], {'PASS': 29089})
        self.assertEqual(comparison['native_snapshot_sha256'], M['digest'](world.native))
        provider = {'schema': 'workinants.native-deny-provider-preinstall.v1', 'run_id': run, 'container_id': cid, 'source_commit': 'a' * 40, 'source_tree': 'b' * 40, 'packet_sha256': N['PACKET_SHA'], 'application_sql_sha256': M['APPLICATION_SHA'], 'roles': N['provider_flags'](), 'all_nine_schema_usage_sentinels_before_install': True, 'canonical_install_removed_all_nine': True, 'genuine_prisma_one_applied_migration': True, 'original_grantor_finalized': True, 'local_simulation_only': True, 'hosted_parity_claimed': False}
        native = {'schema': 'workinants.native-deny-run.v1', 'scope': 'FINITE_NATIVE_DENIAL_FACETS_ONLY', 'run_id': run, 'source_commit': 'a' * 40, 'source_tree': 'b' * 40, 'packet_sha256': N['PACKET_SHA'], 'source_modules_sha256': {p: pins[p] for p in N['MODULES']}, 'target_manifest': deepcopy(self.target), 'immutable_container_id': cid, 'selected_case_ids': self.legacy['NATIVE_PACKET']['selected_case_ids']}
        for key, value in (('native_snapshot', world.native), ('native_comparison', comparison), ('provider_preinstall_proof', provider)):
            native[key] = asset('OFFLINE_TEST_ONLY_' + key, value)
        value = {'schema': 'workinants.privilege-ceiling-run.v1', 'scope': 'FINITE_EXISTING_PRIVILEGE_CEILINGS_ONLY', 'run_id': run, 'source_commit': 'a' * 40, 'source_tree': 'b' * 40, 'packet_sha256': aggregate(pins), 'packet_files_sha256': deepcopy(pins), 'fixtures_sha256': self.master['privilege_ceiling']['fixtures_sha256'], 'content_sha256': self.master['privilege_ceiling']['content_sha256'], 'native_plan': native}
        attestation = {'schema': 'workinants.privilege-ceiling-native-attestation.v1', 'run_id': run, 'container_id': cid, 'source_commit': 'a' * 40, 'source_tree': 'b' * 40, 'operation_packet_sha256': value['packet_sha256'], 'native_sql_packet_sha256': N['PACKET_SHA'], 'application_sql_sha256': M['APPLICATION_SHA'], 'source_expected_sha256': M['EXPECTED_NATIVE'], 'native_snapshot_sha256': M['digest'](world.native), 'native_comparison_file_sha256': native['native_comparison']['sha256'], 'genuine_prisma_one_applied_migration': True, 'original_grantor_finalized': True, 'native_expression_oracle_and_private_ledger_pass': True, 'all_other_client_backends_absent': True, 'provider_preinstall_source_proven': True, 'posture': 'D', 'whole_case_promotion': False}
        value['prerequisite_attestation'] = asset('OFFLINE_TEST_ONLY_prerequisite', attestation)
        return value

    def test_actual_prepare_map_has_all202_generated_bytes_and_same_source_digests(self):
        owned = json.loads((self.root / CLOSURE_REVIEW).read_bytes())
        artifacts = owned['privilege_packet']['artifacts_sha256']

        self.assertNotEqual(self.pins[CLOSURE_COOR], old['packet_files_sha256']['scripts/sql-review/run-privilege-ceiling-control-rehearsal.py'])

    def test_removed_README_rehashed_actual_map_is_still_rejected_by_real_loader(self):
        plan = deepcopy(self.component)
        plan['packet_files_sha256'].pop(CLOSURE_README)
        plan['packet_sha256'] = aggregate(plan['packet_files_sha256'])
        with self.assertRaises(self.M['Held']) as found:
            self.M['load_inputs'](plan)
        self.assertEqual(found.exception.code, 'EXACT_SOURCE_PACKET_REPRODUCTION')

    def helper(self):
        n = runpy.run_path(str(self.task / CLOSURE_CORE))['launch'].__globals__
        n['initialize'](self.plan_path)
        exec(compile((self.task / CLOSURE_STEPS).read_bytes(), str(self.task / CLOSURE_STEPS), 'exec'), n)
        return (n, {p: (self.root / p).read_bytes() for p in self.pins}, json.loads((self.root / CLOSURE_REVIEW).read_bytes()), json.loads((self.root / CLOSURE_PACKET / 'fixtures.json').read_bytes()))

    def test_private_precheck_has_no_compiler_and_only_strict_boolean_constants(self):
        n, blobs, owned, fixture = self.helper()
        with patch('builtins.compile', side_effect=AssertionError('PRECHECK_CANNOT_COMPILE')):
            self.assertIsNone(n['privilege_generated_artifact_closure'](blobs, owned, fixture, self.root, reproduce=False))
        for value in (0, 1, None, 'false'):
            with self.subTest(value_type=type(value).__name__), self.assertRaises(n['Stop']) as found:
                n['privilege_generated_artifact_closure'](blobs, owned, fixture, self.root, reproduce=value)
            self.assertEqual(found.exception.code, 'PRIVILEGE_GENERATED_PHASE_SHAPE')

    def test_generation_helper_rejects_missing_rehashed_or_wrong_type_artifacts(self):
        n, blobs, owned, fixture = self.helper()
        cases = []
        b = deepcopy(blobs)
        b.pop(CLOSURE_README)
        cases.append((b, deepcopy(owned), fixture))
        b = deepcopy(blobs)
        b[CLOSURE_README] = CLOSURE_CANARY.encode()
        v = deepcopy(owned)
        v['privilege_packet']['artifacts_sha256'][CLOSURE_README] = sha(b[CLOSURE_README])
        cases.append((b, v, fixture))
        b = deepcopy(blobs)
        b[CLOSURE_README] = CLOSURE_CANARY
        cases.append((b, deepcopy(owned), fixture))
        v = deepcopy(owned)
        v['privilege_packet']['artifacts_sha256'].pop(CLOSURE_README)
        cases.append((deepcopy(blobs), v, fixture))
        v = deepcopy(owned)
        v['privilege_packet']['artifacts_sha256'][CLOSURE_PACKET + '/../' + CLOSURE_CANARY] = v['privilege_packet']['artifacts_sha256'].pop(CLOSURE_README)
        cases.append((deepcopy(blobs), v, fixture))
        f = deepcopy(fixture)
        f['status'] = CLOSURE_CANARY
        cases.append((deepcopy(blobs), deepcopy(owned), f))
        for b, v, f in cases:
            with self.subTest(kind=type(b.get(CLOSURE_README)).__name__), self.assertRaises(n['Stop']) as found:
                n['privilege_generated_artifact_closure'](b, v, f, self.root)
            self.assertNotIn(CLOSURE_CANARY, str(found.exception))

    def test_remove_actual_preparer_full_artifact_union_is_detected(self):
        source = (self.task / CLOSURE_PREP).read_text()
        self.assertEqual(source.count(';inventory.update(artifacts)'), 1)
        mutant = source.replace(';inventory.update(artifacts)', '')
        n = {'__name__': '_offline_old_inventory_mutant', '__file__': str(self.task / CLOSURE_PREP)}
        exec(compile(mutant, str(self.task / CLOSURE_PREP), 'exec'), n)
        run = str(uuid.uuid4())
        with self.assertRaises(n['Refused']) as found:
            n['prepare'](self.baseline, sha(self.baseline.read_bytes()), run)
        self.assertEqual(str(found.exception), 'PRIVILEGE_GENERATED_ARTIFACT_NOT_ADMITTED')
        self.assertFalse((self.task / ('local-f0-privilege-ceiling-plan-' + run[:8])).exists())

    def actual_entry(self, missing=False, pending=False):
        m = deepcopy(self.pinned)
        m['review_status'] = 'APPROVED_LOCAL_F0_PRIVILEGE_CEILING_ATTEMPT'
        if missing:
            m['packet_files_sha256'].pop(CLOSURE_README)
        pending_raw = None
        if pending:
            v = json.loads((self.root / CLOSURE_REVIEW).read_bytes())
            v['independent_safety_sql_review'] = {'decision': 'PENDING_ROOT_AND_INDEPENDENT_REVIEW'}
            pending_raw = encoded(v)
            m['packet_files_sha256'][CLOSURE_REVIEW] = sha(pending_raw)
        m['packet_sha256'] = aggregate(m['packet_files_sha256'])
        manifest = self.directory / 'operation-manifest.json'
        manifest.write_bytes(encoded(m))
        module = runpy.run_path(str(self.task / CLOSURE_CORE))
        n = module['launch'].__globals__
        calls = []
        project_compiles = []
        actual_read = Path.read_bytes
        actual_compile = compile

        def read(path):
            return pending_raw if pending_raw is not None and path == self.root / CLOSURE_REVIEW else actual_read(path)

        def compile_(source, filename, *args, **kwargs):
            if str(filename).startswith(str(self.root / 'scripts')):
                project_compiles.append(str(filename))
            return actual_compile(source, filename, *args, **kwargs)

        def process(args, **kwargs):
            if args[:3] == ['git', '-c', 'core.longpaths=true']:
                if args[3:] == ['rev-parse', 'HEAD']:
                    return SimpleNamespace(returncode=0, stdout='a' * 40 + '\n', stderr='')
                if args[3:] == ['rev-parse', 'HEAD^{tree}']:
                    return SimpleNamespace(returncode=0, stdout='b' * 40 + '\n', stderr='')
                assert args[3] == 'show'
                return SimpleNamespace(returncode=0, stdout=read(self.root / args[4].split(':', 1)[1]), stderr=b'')
            assert args[:3] == ['docker', '--context', 'desktop-linux']
            tail = args[3:]
            calls.append(tail)
            if tail in (['container', 'ls', '-a', '--format', '{{.Names}}'], ['volume', 'ls', '--format', '{{.Name}}']):
                return SimpleNamespace(returncode=0, stdout='', stderr='')
            if tail == ['context', 'inspect', 'desktop-linux']:
                raise n['Stop']('OFFLINE_RESOURCE_STAGE_REACHED')
            raise AssertionError('UNDECLARED_RESOURCE_ACTION')
        output = io.StringIO()
        with patch.dict(sys.modules):
            for key in ('catalog_manifest', 'pg17_catalog_rules', 'prisma_ledger_proof', 'compare_native_catalog', 'catalog_expression_oracle', 'migration_server_diagnostics'):
                sys.modules.pop(key, None)
            with patch.object(Path, 'read_bytes', read), patch('builtins.compile', compile_), patch.object(subprocess, 'run', side_effect=process), redirect_stdout(output), redirect_stderr(output):
                code = module['launch'](['--execute-reviewed-privilege-ceilings', '--manifest', str(manifest)])
        self.assertEqual(code, 1)
        self.assertNotIn(CLOSURE_CANARY, output.getvalue())
        out = Path(m['evidence_directory'])
        assert out.parent == self.task and out.name.startswith('local-f0-privilege-ceiling-') and (not out.is_relative_to(self.root))
        shutil.rmtree(out)
        return (n, calls, project_compiles)

    def test_real_initialized_entry_refuses_missing_README_before_resources_and_helpers(self):
        n, calls, compiled = self.actual_entry(missing=True)
        self.assertEqual(n['report']['primary_failure']['code'], 'PRIVILEGE_GENERATED_ARTIFACT_NOT_ADMITTED')
        self.assertEqual(compiled, [])
        self.assertFalse(any((c[:2] in (['container', 'create'], ['volume', 'create'], ['image', 'inspect'], ['context', 'inspect']) for c in calls)))
        self.assertTrue(n['report']['cleanup_actions_confirmed'])

    def test_isolated_pending_gate_precedes_new_pure_project_compilation(self):
        n, calls, compiled = self.actual_entry(pending=True)
        self.assertEqual(n['report']['primary_failure']['code'], 'SAFETY_SQL_REVIEW_REQUIRED')
        self.assertEqual(compiled, [])
        self.assertFalse(any((c[:2] == ['context', 'inspect'] for c in calls)))

    def test_real_initialized_complete_entry_reaches_only_first_resource_boundary(self):
        n, calls, compiled = self.actual_entry()
        self.assertEqual(n['report']['primary_failure']['code'], 'OFFLINE_RESOURCE_STAGE_REACHED')
        self.assertEqual(n['report']['privilege_generated_artifact_closure']['generated_artifacts'], 202)
        self.assertTrue(compiled)
        self.assertEqual(compiled[0], str(self.root / 'scripts/prepare-native-catalog-review.py'))
        self.assertGreater(compiled.index(str(self.root / CLOSURE_COOR)), compiled.index(str(self.root / 'scripts/sql-review/catalog_expression_oracle.py')))
        self.assertEqual(n['report']['source_verification']['file_count'], len(self.pins))
        self.assertFalse(any((c[:2] in (['container', 'create'], ['volume', 'create'], ['image', 'inspect']) for c in calls)))

    def test_real_pinner_refuses_missing_current_and_committed_README_without_mutation(self):
        g = self.pinner['pin'].__globals__
        original_git = g['git_read']
        actual_read = Path.read_bytes
        baseline = self.plan_path.read_bytes()
        for mode in ('missing_admission', 'current_drift', 'committed_drift', 'incomplete_validation', 'duplicate_manifest_field'):
            with self.subTest(mode=mode):
                m = json.loads(self.unpinned)
                v = None
                if mode == 'missing_admission':
                    m['prepared_source_file_inventory_sha256'].pop(CLOSURE_README)
                if mode == 'incomplete_validation':
                    v = json.loads((self.root / CLOSURE_REVIEW).read_bytes())
                    v['privilege_packet']['artifacts_sha256'].pop(CLOSURE_README)
                    v = encoded(v)
                    m['prepared_source_file_inventory_sha256'][CLOSURE_REVIEW] = sha(v)
                raw = encoded(m)
                if mode == 'duplicate_manifest_field':
                    raw = raw.replace(b'{', b'{"purpose":"' + CLOSURE_CANARY.encode() + b'",', 1)
                self.plan_path.write_bytes(raw)

                def read(path):
                    if mode == 'current_drift' and path == self.root / CLOSURE_README:
                        return CLOSURE_CANARY.encode()
                    if v is not None and path == self.root / CLOSURE_REVIEW:
                        return v
                    return actual_read(path)

                def git(*args, input=None):
                    output = original_git(*args, input=input)
                    if mode == 'committed_drift' and args == ('cat-file', '--batch'):
                        output = b''
                        for request in input.decode().splitlines():
                            relative = request.split(':', 1)[1]
                            body = CLOSURE_CANARY.encode() if relative == CLOSURE_README else actual_read(self.root / relative)
                            output += b'0' * 40 + b' blob ' + str(len(body)).encode() + b'\n' + body + b'\n'
                    return output
                try:
                    with patch.object(Path, 'read_bytes', read), patch.dict(g, git_read=git), self.assertRaises(g['Held']) as found:
                        g['pin'](self.plan_path)
                    self.assertNotIn(CLOSURE_CANARY, str(found.exception))
                    self.assertEqual(actual_read(self.plan_path), raw)
                    expected = {'missing_admission': 'PRIVILEGE_GENERATED_ARTIFACT_NOT_ADMITTED', 'current_drift': 'CURRENT_SOURCE_HASH_MISMATCH', 'committed_drift': 'COMMITTED_SOURCE_HASH_MISMATCH', 'incomplete_validation': 'PRIVILEGE_EXACT202_ARTIFACT_MAP_REQUIRED', 'duplicate_manifest_field': 'DUPLICATE_JSON_KEY'}
                    self.assertEqual(str(found.exception), expected[mode])
                finally:
                    self.plan_path.write_bytes(baseline)

    def test_generated_closure_refuses_extra_replaced_unknown_and_nonhash_metadata(self):
        n, blobs, owned, fixture = self.helper()
        cases = []
        v = deepcopy(owned)
        v['privilege_packet']['artifacts_sha256'][CLOSURE_PACKET + '/extra.txt'] = sha(b'')
        b = deepcopy(blobs)
        b[CLOSURE_PACKET + '/extra.txt'] = b''
        cases.append((b, v))
        v = deepcopy(owned)
        v['privilege_packet']['artifacts_sha256'][CLOSURE_README] = True
        cases.append((deepcopy(blobs), v))
        v = deepcopy(owned)
        v['privilege_packet']['artifacts_sha256'][CLOSURE_PACKET + '/unknown.txt'] = v['privilege_packet']['artifacts_sha256'].pop(CLOSURE_README)
        b = deepcopy(blobs)
        b[CLOSURE_PACKET + '/unknown.txt'] = b.pop(CLOSURE_README)
        cases.append((b, v))
        for b, v in cases:
            with self.subTest(size=len(v['privilege_packet']['artifacts_sha256'])), self.assertRaises(n['Stop']) as found:
                n['privilege_generated_artifact_closure'](b, v, fixture, self.root)
            self.assertNotIn(CLOSURE_CANARY, str(found.exception))

    def test_real_coordinator_SQL_projection_composition_uses_actual_preparation_map(self):
        before = encoded(self.component['packet_files_sha256'])
        loaded = self.M['load_inputs'](self.component)
        packet, blobs, protocol, native, ctx, np, nb, snapshot, api, host = loaded
        memory = self.legacy['MemoryEvidence']()
        self.world.evidence = memory
        Runner = self.M['runner_type'](native, ctx, protocol)
        runner = Runner(self.component, packet, blobs, np, nb, snapshot, api, host, memory)
        with patch.object(subprocess, 'run', side_effect=self.world.run), patch.object(subprocess, 'check_output', side_effect=self.world.check_output), patch.object(subprocess, 'Popen', side_effect=lambda *a, **k: self.legacy['Process'](self.world, *a, **k)):
            runner.run()
        self.assertEqual(encoded(self.component['packet_files_sha256']), before)
        self.assertEqual((len(memory.value['results']), len(memory.value['definer_metadata']), len(memory.value['native_controls']), len(memory.value['issuer_protocols']), len(memory.value['operations'])), (200, 16, 40, 3, 244))
        self.assertEqual(memory.value['facets'], [])
        record = next((r for r in memory.value['operations'] if r['name'] == 'ISSUER-LEGITIMATE-PERSON-ISSUE-OWN-READ-BOUND-SCALARS'))
        self.assertEqual(record['caller_path_comparisons'], [True, True])
        self.assertEqual(len(record['caller_path_comparison_outcomes']), 2)
        self.assertTrue(all((all((v is True for v in checks.values())) for checks in record['caller_path_comparison_outcomes'])))
        self.assertTrue(all((p.poll() is not None for p in self.world.processes)))
        self.assertTrue(all((r['status'] == 'NOT_RUN' for r in packet['control_links'])))

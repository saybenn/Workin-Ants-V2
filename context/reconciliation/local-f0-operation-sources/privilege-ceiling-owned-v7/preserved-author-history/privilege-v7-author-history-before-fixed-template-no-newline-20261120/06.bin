   actual=json.loads(admitted[path]);need(actual.get('decision')=='SOURCE_APPROVED' and actual.get(field)==expected,'V7_SOURCE_REVIEW_BYTES_REQUIRED')
 for name,wanted in packet['source_files_sha256'].items():source(name,wanted)

      "source_path": "review-output/foundation-application.review.sql",
      "source_rule": "row_allowed always requires a selected versioned row own Model/id/revision token. It compares g.source_generation to authorized_revision only if g.target_kind=model_name AND g.target_id=row_key."
    }

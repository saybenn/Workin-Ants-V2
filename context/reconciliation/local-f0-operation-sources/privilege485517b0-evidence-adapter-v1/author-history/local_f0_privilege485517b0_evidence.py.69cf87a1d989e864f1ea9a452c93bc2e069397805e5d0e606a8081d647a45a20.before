    same(n['known_executor_exit'],{'code':0,'parent_observation_path':ASSET+'/known-closed-parent.json','sha256':sh(blobs[ASSET+'/known-closed-parent.json'])},'NORMALIZED_KNOWN_CLOSED_REFERENCE')
    same([n['operator_reported_started_at'],n['operator_reported_finished_at']],[parent['started_at'],parent['finished_at']],'REPORTED_TIMES_PRESERVED_NOT_INVENTED')
    for k in ('finite200_completed','all244_operation_connections_closed','all849_child_global_zero_boundaries','provider18_positions_strictly_matched','provider_simulation_only'): need(n['facts'][k]is True,'NORMALIZED_FINITE_FACTS')

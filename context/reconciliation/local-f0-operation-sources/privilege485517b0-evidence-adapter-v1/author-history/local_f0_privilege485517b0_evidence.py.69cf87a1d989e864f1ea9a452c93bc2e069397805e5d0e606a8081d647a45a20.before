    same(n['limits'],{'Posture':'D','full94_or451_promoted':False,'production_readiness':False,'hosted_adoption':False,'worker_loop':False,'App_Worker_business_qualification':False},'NORMALIZED_LIMITS_NO_PROMOTION')
    same(n['cleanup'],{'independently_absent_exact_C1V':True,'private_credentials_absent':True,'pinned_image_retained':True},'NORMALIZED_CLEANUP_FACTS')
    return n

def _history(blobs, spec):
    old=doc(blobs[ARCHIVE+'/prior687-assertion-evidence.json']); rows=old['assertions']
    need(len(rows)==687 and len(old['executions'])==14,'PRIOR687_AND14_EXECUTIONS')
    same(rows[70],spec['prior_issuer_row70'],'FULL_PREVIOUS_ISSUER_ROW70')
    need(rows[70]['status']=='PARTIAL' and rows[70]['case_id']=='P0C-PRIV-01' and rows[70]['assertion_id']=='control.issuer_ceiling','HISTORICAL_ISSUER_REMAINS_PARTIAL')
    need(rows[70]['evidence_sha256']==sh(blobs[ARCHIVE+'/prior-issuer-partial-record.json']) and rows[70]['json_pointer']=='/sanitized_report/control_packets','GENUINE_PREVIOUS_EVIDENCE_REFERENCE')
    oldrecord=doc(blobs[ARCHIVE+'/prior-issuer-partial-record.json'])
    need(oldrecord['source_commit']==rows[70]['source_commit'] and oldrecord['source_tree']==rows[70]['source_tree'] and oldrecord['run_id']==rows[70]['run_id'],'OLD_SOURCE_EXECUTION_HISTORY')
    build=doc(blobs[ARCHIVE+'/validating-full687-build.json'])
    same(build,spec['validating_build_contract'],'ACTUAL_UNMOCKED_PRIOR687_BUILD')
    status=doc(blobs[ARCHIVE+'/prior687-qualification-status.json'])
    need(build['status']=='PASS_REAL_FULL687_ROOT_BUILD' and build['producer_or_validation_functions_mocked']is False and build['counts_forced']is False and build['old684_rows_and_old_executions_unchanged']is True,'GENUINE_UNMOCKED_PRIOR_BUILD')
    need(build['ledger_sha256']==build['candidate_ledger_sha256']==sh(blobs[ARCHIVE+'/prior687-assertion-evidence.json']) and build['qualification_status_sha256']==sh(blobs[ARCHIVE+'/prior687-qualification-status.json']),'HISTORICAL_BUILD_BASELINE_BYTES')
    same([r for r in rows if r['case_id']=='P0C-RESTORE-01'],spec['prior_Restore3_rows'],'HISTORICAL_RESTORE3_PRESERVED')
    need(digest(status)==spec['prior_status_semantic_sha256'],'PRIOR_STATUS_HISTORY_BINDING')
    # Preserve the old per-row validator unchanged. The new reader does not
    # execute it or pretend that a historical complete-batch bridge exists.
    need(sh(blobs[ARCHIVE+'/prior-restricted-validator.py.txt'])=='8809426d7dba4cc2f14f41b1b3230dbb704f758542d42134e2d0ea25b25054f3','UNCHANGED_OLD_PER_ROW_VALIDATOR')
    need(sh(blobs[ARCHIVE+'/prior-builder7a2.py.txt'])=='7a2aec1c5d66b813fd610447421ca11418812478319d4a623434bf6f1ca61029','UNCHANGED_OLD_BUILDER')
    return old

def _audit_semantics(blobs):
    """Validate retained actual meaning separately from hash admission envelopes."""
    spec=doc(blobs[SPEC]); parent=doc(blobs[ASSET+'/evidence/run-evidence.json'])
    for path,frame in spec['sanitized_json_frames'].items(): same(_frame(doc(blobs[path])),frame,'EXACT_ALLOWLISTED_JSON_FRAME')
    need(parent['status']=='PASS_LOCAL_PRIVILEGE_CEILING_SQL_SUBSET_ONLY' and parent['evidence_complete']is True and parent['persistence_failure']is False and parent['output_complete']is True and parent['unexpected']==[],'COMPLETE_CLOSED_PARENT')
    same(parent['limits'],{'posture':'D','451_register':'NOT_PROMOTED','94_selection':'NOT_PROMOTED','hosted_changes':False,'migration_adoption':False,'worker_loop':False,'production_readiness':False},'PARENT_POSTURE_AND_EXECUTION_LIMITS')
    manifest,fixture,native_packet,descriptors,migration=_source(blobs,spec,parent)
    policy,native=_native(blobs,spec,fixture,parent,migration)
    child=_component(blobs,spec,parent,fixture,native_packet,descriptors,policy)
    _authority_and_cleanup(blobs,spec,parent,child,manifest); _normalization(blobs,parent,child); old=_history(blobs,spec)
    inventory=doc(blobs['context/reconciliation/local-f0-assertions.json']); requirements={(c['id'],a['id']):a for c in inventory['cases'] for a in c['assertions']}
    claims=[]
    expected_keys=[(r['case_id'],r['assertion_id']) for r in fixture['issuer_umbrella_links'] if r['model']!='DatabaseActionGrant']+[(r['case_id'],r['assertion_id']) for r in fixture['control_links']]
    same([(r['case_id'],r['assertion_id']) for r in spec['claim_maxima']],expected_keys,'EXACT_SOURCE39_PLUS_FIVE_IDENTITIES')
    for source in spec['claim_maxima']:
        key=source['case_id'],source['assertion_id']; need(key in requirements and sh(requirements[key]['expected_assertion'].encode())==source['expected_assertion_sha256'],'SOURCE_ASSERTION_EXPECTATION')
        status=source['proposed_maximum']; maximum='PARTIAL' if key[1]in ('control.issuer_ceiling','control.helper_ceiling','control.browser_simulation') else 'PASS'; need(status==maximum,'SOURCE_FIXED_CLAIM_MAXIMUM')
        claim={'case_id':key[0],'assertion_id':key[1],'status':status,'expected_assertion_sha256':source['expected_assertion_sha256'],'scope_limit':source['scope_limit']}
        if key==('P0C-PRIV-01','control.issuer_ceiling'): need(status=='PARTIAL','ISSUER_CEILING_PARTIAL'); claim['previous_evidence']=old['assertions'][70]
        claims.append(claim)
    need(len(claims)==44 and len({(r['case_id'],r['assertion_id']) for r in claims})==44 and sum(r['status']=='PASS' for r in claims)==41 and sum(r['status']=='PARTIAL' for r in claims)==3,'EXACT44_CEILINGS')
    need(not any(r['case_id']=='P0C-TABLE-DatabaseActionGrant-DENY' for r in claims),'UNDISAMBIGUATED_DAG_UMBRELLA_NO_LINK')
    return claims

def audit_semantics(blobs):
    try: return _audit_semantics(blobs)
    except EvidenceFailure: raise
    except Exception: raise EvidenceFailure('PRIVILEGE485517B0_SEMANTICS_REJECTED') from None

def expected_record(blobs):
    claims=audit_semantics(blobs); spec=doc(blobs[SPEC])
    return {'schema':'workinants.privilege485517b0-qualified-evidence.v1','derivation':'EXPLICIT_RETROSPECTIVE_WRAPPER_NOT_ANOTHER_DATABASE_EXECUTION','actual_result':KIND,'run_id':RUN,'source_commit':COMMIT,'source_tree':TREE,'packet_sha256':PACKET,'application_sql_sha256':APP,'source_record':{'path':REC,'sha256':PINS[REC]},'raw_parent':{'path':ASSET+'/evidence/run-evidence.json','sha256':PINS[ASSET+'/evidence/run-evidence.json']},'raw_child':{'path':ASSET+'/evidence/privilege-ceiling-component/privilege-ceiling-results.json','sha256':PINS[ASSET+'/evidence/privilege-ceiling-component/privilege-ceiling-results.json']},'input_files_sha256':{p:h for p,h in PINS.items() if p!=DERIVED},'claims':claims,'limits':spec['limits']}

def validate_bundle(blobs):
    need(type(blobs)is dict and set(blobs)==set(PINS),'EXACT_CLOSED519_GRAPH')
    need(all(type(b)is bytes and sh(b)==PINS[p] for p,b in blobs.items()),'CAPTURED_GRAPH_HASHES')
    value=doc(blobs[DERIVED]); same(value,expected_record(blobs),'EXACT_DERIVED44_AND_HISTORY')
    return canonical(value)

def _expected_row(claim, index):
    row={k:claim[k] for k in ('case_id','assertion_id','status','expected_assertion_sha256')}
    row.update(source_commit=COMMIT,source_tree=TREE,packet_sha256=PACKET,application_sql_sha256=APP,run_id=RUN,evidence_path=DERIVED,evidence_sha256=PINS[DERIVED],json_pointer='/claims/'+str(index),qualification_scope='Exact finite retrospective V9 SQL privilege subset only.',qualification_limit=claim['scope_limit'])
    if 'previous_evidence'in claim: row['previous_evidence']=copy.deepcopy(claim['previous_evidence'])
    return row

def propose_ledger_delta(current, execution):
    """Pure 43 additions plus one PARTIAL replacement; never writes a ledger."""
    typed(current); typed(execution)

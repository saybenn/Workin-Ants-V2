  "reviewed_non_subscription_routes": [
    {
      "event": "identity.platform_role_changed.v1",
      "route": "Identity invalidates assurance; Role uses fresh current Identity assignment facts. No Role stream/cache."
    },
    {
      "event": "professional.readiness_changed.v1",
      "route": "Gig/Order check current owner readiness before new action. Marketplace/Search subscribe for reevaluation."
    },
    {
      "event": "offering.publication_changed.v1",
      "route": "Order checks current Offering source revision at checkout; Search subscribes for projection invalidation."
    },
    {
      "event": "booking.confirmed.v1 / booking.rescheduled.v1 / booking.cancelled.v1",
      "route": "Notification uses separate source intent; Calendar provider reconciliation remains within Booking owner."
    },
    {
      "event": "interview lifecycle",
      "route": "Candidate subscriber is optional owner-governed stage handling, disabled until separately qualified; no event assigns application stage directly."
    },
    {
      "event": "messaging.*",
      "route": "Authorized realtime invalidation with current audience only; Notification receives message.new.v1 intent rather than domain event fanout."
    },
    {
      "event": "privacy.request_changed.v1 / privacy.execution_changed.v1",
      "route": "Ops restricted diagnostics subscription; requester Notification uses safe intent. Executors use scoped commands."
    },
    {
      "event": "ops.incident_changed.v1",
      "route": "Separate authorized operator Notification intent; no domain mutation."
    },
    {
      "event": "reward.fulfillment_changed.v1",
      "route": "Payment tax-recognition input subject to approved policy; Track benefit fulfillment remains explicit command/receipt."
    },
    {
      "event": "hold.applicability_changed.v1",
      "route": "Only registered typed target/action owners under hold-action-contracts.md (R075); no generic all-module subscription or automatic restoration."
    },
    {
      "event": "location.disclosure_changed.v1",
      "route": "Search/Media/Video named effects; additional context consumers require explicit source-context registration. No exact coordinates or new generic disclosure dependency."
    },
    {
      "event": "Audit",
      "route": "No broadcast event; acceptance receipts and bounded authorized evidence queries only."
    }
  ],
  "corrections": [
    "Added Search <- Track entitlement (not usage).",
    "Added Messaging <- application lifecycle.",
    "Added Media and Video <- scoped Location disclosure.",
    "Made optional Candidate <- Interview lifecycle explicit.",
    "Separated Notification intents and Role fresh-query obligations from subscriber lists.",
    "Made Gig/Order current readiness and Order checkout freshness explicit."
  ],
  "limits": [
    "Static architecture review, not executable compatibility or feature completion.",
    "Source revisions/replay/tombstones/idempotency/privacy rules verified in incorporated owner appendices; executable fixtures remain activation gates.",
    "R031 no speculative Role stream/cache, Privacy approved-generation assurance and no generic Professional moderation action preserved.",
    "Historical sections and broader Cluster/bridge convergence remain Gate 4/5 work."
  ]
}

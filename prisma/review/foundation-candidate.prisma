  securityTier               UserSecurityTier @default(standard) @map("security_tier")

  phoneNumberEncrypted        String?          @map("phone_number_encrypted")
  phoneNumberHash             String?          @map("phone_number_hash")
  phoneVerifiedAt             DateTime?        @map("phone_verified_at") @db.Timestamptz(6)
  phoneLastChangedAt          DateTime?        @map("phone_last_changed_at") @db.Timestamptz(6)

  passkeysEnabled             Boolean          @default(false) @map("passkeys_enabled")
  smsMfaEnabled               Boolean          @default(false) @map("sms_mfa_enabled")
  backupPasswordConfigured    Boolean          @default(false) @map("backup_password_configured")

  sensitiveActionMfaRequired  Boolean          @default(true) @map("sensitive_action_mfa_required")
  lastStepUpAt                DateTime?        @map("last_step_up_at") @db.Timestamptz(6)
  lastSensitiveActionAt       DateTime?        @map("last_sensitive_action_at") @db.Timestamptz(6)

  lockedUntil                 DateTime?        @map("locked_until") @db.Timestamptz(6)
  lockReason                  String?          @map("lock_reason")

  createdAt                   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                        User             @relation("UserSecurityProfile", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  authProviderAccounts        AuthProviderAccount[]

  @@index([securityTier])
  @@index([phoneNumberHash])
  @@index([lockedUntil])
  @@map("user_security_profiles")
  @@schema("app")

  revision BigInt @default(0) @map("revision")

  securityGeneration BigInt @default(0) @map("security_generation")

  mutationTransactionId String @default(dbgenerated("pg_current_xact_id()::text")) @map("mutation_transaction_id")
}

// Source owner: identity_access. Unique provider/account subject to local User binding
model AuthProviderAccount {
  id                    String               @id @default(uuid()) @db.Uuid
  userId                String               @map("user_id") @db.Uuid
  securityProfileId     String?              @map("security_profile_id") @db.Uuid

  providerType          AuthProviderType     @map("provider_type")
  providerUserId        String?              @map("provider_user_id")
  providerAccountId     String?              @map("provider_account_id")

  email                 String?
  emailVerifiedAt       DateTime?            @map("email_verified_at") @db.Timestamptz(6)

  status                AuthCredentialStatus @default(active)
  linkedAt              DateTime             @default(now()) @map("linked_at") @db.Timestamptz(6)
  lastUsedAt            DateTime?            @map("last_used_at") @db.Timestamptz(6)
  revokedAt             DateTime?            @map("revoked_at") @db.Timestamptz(6)

  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User                 @relation("UserAuthProviderAccounts", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  securityProfile       UserSecurityProfile? @relation(fields: [securityProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, providerType])
  @@index([providerType, providerUserId])
  @@index([providerType, providerAccountId])
  @@index([status])
  @@map("auth_provider_accounts")
  @@schema("app")

  revision BigInt @default(0) @map("revision")

  mutationTransactionId String @default(dbgenerated("pg_current_xact_id()::text")) @map("mutation_transaction_id")
}

// Source owner: track_subscription_entitlement. Versioned Track-owned base benefit catalog; no seeded commercial promise here
model TrackPlan {
  id                  String            @id @default(uuid()) @db.Uuid

  track               AccountTrack
  key                 String
  name                String
  status              TrackPlanStatus   @default(draft)
  billingModel        TrackBillingModel @map("billing_model")

  monthlyPriceCents   Int?              @map("monthly_price_cents")
  currency            String            @default("usd")

  description         String?
  displayOrder        Int               @default(0) @map("display_order")
  metadata            Json?

  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  planEntitlements    TrackPlanEntitlement[]
  subscriptions       TrackSubscription[]
  events              TrackSubscriptionEvent[]

  @@unique([track, key, version])
  @@index([track, status])
  @@map("track_plans")
  @@schema("app")

  revision BigInt @default(0) @map("revision")

  version String
  contentHash String @map("content_hash") @db.Char(64)

  mutationTransactionId String @default(dbgenerated("pg_current_xact_id()::text")) @map("mutation_transaction_id")
}


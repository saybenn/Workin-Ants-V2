// Source owner: consent_disclosure. Immutable exact presented-content acceptance by subject, context and command identity
model ConsentLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid

  type      ConsentType
  version   String

  acceptedAt DateTime   @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ipHash     String?    @map("ip_hash")
  userAgent  String?    @map("user_agent")

  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user                User                   @relation("UserConsentLogs", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, type, acceptedAt])
  @@index([type, version])
  @@map("consent_logs")
  @@schema("app")

  acceptanceKey String @map("acceptance_key")
  fingerprint String @db.Char(64)
  actionOwner String @map("action_owner")
  action String
  contextKind String @map("context_kind")
  contextId String? @map("context_id")
  @@unique([userId, acceptanceKey])

  candidateConsentDispositionProof ConsentDisposition[] @relation("C_ConsentDisposition_proof")

  contentRevisionId String @map("content_revision_id") @db.Uuid

  candidateContentRevisionId ConsentContentRevision @relation("C_ConsentLog_contentRevisionId", fields: [contentRevisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  presentationId String @map("presentation_id") @db.Uuid

  candidatePresentationId ConsentPresentation @relation("C_ConsentLog_presentationId", fields: [presentationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  mutationTransactionId String @default(dbgenerated("pg_current_xact_id()::text")) @map("mutation_transaction_id")
}

// Source owner: privacy_data_erasure. Verified data-rights request and orchestration state; no invented legal response timer
model PrivacyRequest {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @map("user_id") @db.Uuid

  type            PrivacyRequestType
  status          PrivacyRequestStatus @default(submitted)

  requestedAt     DateTime             @default(now()) @map("requested_at") @db.Timestamptz(6)
  verifiedAt      DateTime?            @map("verified_at") @db.Timestamptz(6)
  dueAt           DateTime?            @map("due_at") @db.Timestamptz(6)
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz(6)

  rejectionReason String?              @map("rejection_reason")
  adminNote       String?              @map("admin_note")

  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User                 @relation("UserPrivacyRequests", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, status])
  @@index([type, status])
  @@index([dueAt])
  @@map("privacy_requests")
  @@schema("app")

  revision BigInt @default(0) @map("revision")

  privacyGeneration BigInt @default(0) @map("privacy_generation")

  instructionGeneration BigInt @default(0) @map("instruction_generation")

  candidatePrivacyTargetInstructionRequest PrivacyTargetInstruction[] @relation("C_PrivacyTargetInstruction_request")

  mutationTransactionId String @default(dbgenerated("pg_current_xact_id()::text")) @map("mutation_transaction_id")
}

// Source owner: identity_access. Minimized Identity eligibility attempt, distinct from Consent acknowledgment
model AgeGateAttempt {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String?       @map("user_id") @db.Uuid

  ipHash       String?       @map("ip_hash")
  deviceHash   String?       @map("device_hash")
  region       String?
  result       AgeGateResult

  birthYear    Int?          @map("birth_year")
  ageBand      String?       @map("age_band")
  blockedUntil DateTime?     @map("blocked_until") @db.Timestamptz(6)

  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User?         @relation("UserAgeGateAttempts", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
  @@index([deviceHash, createdAt])
  @@index([result, createdAt])
  @@index([blockedUntil])
  @@map("age_gate_attempts")
  @@schema("app")

  mutationTransactionId String @default(dbgenerated("pg_current_xact_id()::text")) @map("mutation_transaction_id")
}

// Source owner: identity_access. Purpose-bound Identity abuse/rate restriction, not a minor account
model AgeGateBlock {
  id           String   @id @default(uuid()) @db.Uuid
  ipHash       String?  @map("ip_hash")
  deviceHash   String?  @map("device_hash")
  reason       String
  blockedUntil DateTime @map("blocked_until") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ipHash, blockedUntil])
  @@index([deviceHash, blockedUntil])
  @@map("age_gate_blocks")
  @@schema("app")

  mutationTransactionId String @default(dbgenerated("pg_current_xact_id()::text")) @map("mutation_transaction_id")
}

// Source owner: audit_event_ledger. Durable protected-disclosure proof before secret delivery
model AccessAuditLog {
  id             String                    @id @default(uuid()) @db.Uuid
  actorUserId    String?                   @map("actor_user_id") @db.Uuid
  targetType     String                    @map("target_type")
  targetId       String                    @map("target_id") @db.Uuid
  action         AccessAuditAction
  sensitivity    DataSensitivity           @default(normal)
  accessDecision HealthcareAccessDecision? @map("access_decision")
  requestId      String?                   @map("request_id")
  ipHash         String?                   @map("ip_hash")
  userAgent      String?                   @map("user_agent")
  previousHash   String?                   @map("previous_hash")
  entryHash      String?                   @map("entry_hash")
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  actorUser      User?                     @relation("UserAccessAuditLogs", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([sensitivity, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
  @@map("access_audit_logs")
  @@schema("app")

  mutationTransactionId String @default(dbgenerated("pg_current_xact_id()::text")) @map("mutation_transaction_id")
}

// Source owner: identity_access. Local account principal; not a seller or inferred commercial buyer
model User {
  id          String  @id @default(uuid()) @db.Uuid
  email       String? @unique
  handle      String? @unique
  displayName String? @map("display_name")
  avatarUrl   String? @map("avatar_url")
  bio         String?
  city        String?
  state       String?
  country     String?
  isPublic    Boolean @default(true) @map("is_public")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles               UserRole[]
  professionalProfile ProfessionalProfile?
  candidateProfile    CandidateProfile?
  customerProfile CustomerProfile? @relation("UserCustomerProfile")
trackSubscriptions TrackSubscription[]
trackEntitlementGrants TrackEntitlementGrant[]
trackUsageEvents TrackUsageEvent[]
trackUsageCounts TrackUsageCounter[]
trackSubscriptionEvents TrackSubscriptionEvent[]


  consentLogs                  ConsentLog[]          @relation("UserConsentLogs")

  privacyErasedAt      DateTime? @map("privacy_erased_at") @db.Timestamptz(6)
  privacyErasureStatus String?   @map("privacy_erasure_status")
  privacyRequests             PrivacyRequest[]              @relation("UserPrivacyRequests")
  ageGateAttempts             AgeGateAttempt[]              @relation("UserAgeGateAttempts")
  accessAuditLogs             AccessAuditLog[]              @relation("UserAccessAuditLogs")
  securityProfile          UserSecurityProfile?      @relation("UserSecurityProfile")
  authProviderAccounts     AuthProviderAccount[]     @relation("UserAuthProviderAccounts")





  @@index([isPublic])
  @@index([city, state, country])
  @@map("users")
  @@schema("app")

  revision BigInt @default(0) @map("revision")

  privacyGeneration BigInt @default(0) @map("privacy_generation")

  candidateConsentDispositionSubject ConsentDisposition[] @relation("C_ConsentDisposition_subject")

  candidateCustomerProfileLifecycleEventActor CustomerProfileLifecycleEvent[] @relation("C_CustomerProfileLifecycleEvent_actor")

  candidateTrackBaseSelectionUser TrackBaseSelection[] @relation("C_TrackBaseSelection_user")

  candidateTrackEnrollmentReceiptUser TrackEnrollmentReceipt[] @relation("C_TrackEnrollmentReceipt_user")

  candidateTrackUsageReservationUser TrackUsageReservation[] @relation("C_TrackUsageReservation_user")



  mutationTransactionId String @default(dbgenerated("pg_current_xact_id()::text")) @map("mutation_transaction_id")
}


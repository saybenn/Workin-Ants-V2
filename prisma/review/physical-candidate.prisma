  @@schema("app")

  run PrizeDrawingRun @relation("C_PrizePopulationMember_run", fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  entry PrizeEntry @relation("C_PrizePopulationMember_entry", fields: [entryId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  mutationTransactionId String @default(dbgenerated("pg_current_xact_id()::text")) @map("mutation_transaction_id")
}

// Source owner: sweepstakes_prize. Later-phase actual fulfillment/valuation receipt; winning does not establish taxable fulfillment
model PrizeFulfillmentReceipt {
  id String @id @default(uuid()) @db.Uuid
  winningId String @map("winning_id") @db.Uuid
  effectReceiptId String @map("effect_receipt_id") @db.Uuid
  semanticEffectKey String @unique @map("semantic_effect_key")
  actualFulfillmentRef String @map("actual_fulfillment_ref")
  recognizedValueCents Int? @map("recognized_value_cents")
  currency String
  recognizedAt DateTime? @map("recognized_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("prize_fulfillment_receipt")
  @@schema("app")

  winning PrizeWinning @relation("C_PrizeFulfillmentReceipt_winning", fields: [winningId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  effect RuntimeEffectReceipt @relation("C_PrizeFulfillmentReceipt_effect", fields: [effectReceiptId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  mutationTransactionId String @default(dbgenerated("pg_current_xact_id()::text")) @map("mutation_transaction_id")
}

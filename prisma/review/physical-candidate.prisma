// Source owner: trust_verification_screening. Versioned Trust screening package and commercial quote inputs; not clearance or Payment truth
model VerificationPackage {
  id              String                    @id @default(uuid()) @db.Uuid

  type            VerificationPackageType
  status          VerificationPackageStatus @default(draft)

  name            String
  description     String?

  vendor          VerificationVendor

  platformFeeCents Int @map("platform_fee_cents")
  currency        String                    @default("usd")

  nonRefundable Boolean @map("non_refundable")
  disclosureText  String?                   @map("disclosure_text")

  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  items           VerificationPackageItem[]
  requirements    VerificationRequirement[]
  checks          VerificationCheck[]

  @@index([type, status])
  @@map("verification_packages")
  @@schema("app")


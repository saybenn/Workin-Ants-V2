  validatedAt            DateTime?                @map("validated_at")
  scannedAt              DateTime?                @map("scanned_at")
  processedAt            DateTime?                @map("processed_at")
  rejectedAt             DateTime?                @map("rejected_at")

  sourceMediaAsset       MediaAsset?              @relation("MediaAssetDerivatives", fields: [sourceMediaAssetId], references: [id])
  derivatives            MediaAsset[]             @relation("MediaAssetDerivatives")

model VerificationPackage {
  id              String                    @id @default(uuid()) @db.Uuid

  type            VerificationPackageType
  status          VerificationPackageStatus @default(draft)

  name            String
  description     String?

  vendor          VerificationVendor
  platformFeeCents Int                     @default(1000) @map("platform_fee_cents")
  currency        String                    @default("usd")

  nonRefundable   Boolean                   @default(true) @map("non_refundable")
  disclosureText  String?                   @map("disclosure_text")

  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  items           VerificationPackageItem[]
  requirements    VerificationRequirement[]
  checks          VerificationCheck[]

  @@index([type, status])
  @@map("verification_packages")
  @@schema("app")
}

model VerificationPackageItem {
  id                    String                @id @default(uuid()) @db.Uuid
  packageId             String                @map("package_id") @db.Uuid

  checkType             VerificationCheckType @map("check_type")
  label                 String

  vendorCostCents       Int                   @map("vendor_cost_cents")
  estimated             Boolean               @default(false)

  displayOrder          Int                   @default(0) @map("display_order")

  package               VerificationPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([checkType])
  @@map("verification_package_items")
  @@schema("app")
}


  isActive     Boolean @default(true) @map("is_active")
  salesTaxLineItems SalesTaxLineItem[] @relation("PricingTierSalesTaxLineItems")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId, isActive])
  @@map("pricing_tiers")
  @@schema("app")
}

model OfferingMedia {
  offeringId String @map("offering_id") @db.Uuid
  mediaId    String @map("media_id") @db.Uuid
  sortOrder  Int    @default(0) @map("sort_order")

  offering Offering   @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([offeringId, mediaId])
  @@index([mediaId])
  @@map("offering_media")
  @@schema("app")
}

model OfferingTag {
  offeringId String    @map("offering_id") @db.Uuid
  tagId      String    @map("tag_id") @db.Uuid
  source     TagSource @default(user)
  confidence Float?
  verified   Boolean   @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  offering Offering    @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  tag      TaxonomyTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([offeringId, tagId])
  @@index([tagId])
  @@index([source])
  @@index([verified])
  @@map("offering_tags")
  @@schema("app")
}

/**
 * =========================================================
 * PUBLIC GIG BOARD
 * Gigs are public paid requests posted by Users.
 * Professionals respond.
 * Accepted responses become GigAssignments and then Orders.
 * =========================================================
 */

model Gig {
  id           String @id @default(uuid()) @db.Uuid
  posterUserId String @map("poster_user_id") @db.Uuid
customerProfileId String? @map("customer_profile_id") @db.Uuid
customerProfile CustomerProfile? @relation("CustomerProfilePostedGigs", fields: [customerProfileId], references: [id])
  title       String
  description String
  status      GigStatus     @default(draft)
  visibility  GigVisibility @default(public)

  domainId   String  @map("domain_id") @db.Uuid
  categoryId String? @map("category_id") @db.Uuid

  budgetMinCents Int?   @map("budget_min_cents")
  budgetMaxCents Int?   @map("budget_max_cents")
  currency       String @default("usd")

  location String?
  city     String?
  state    String?
  country  String?
  remoteOk Boolean @default(true) @map("remote_ok")

  dueAt    DateTime? @map("due_at")
  closesAt DateTime? @map("closes_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  poster   User              @relation("GigPoster", fields: [posterUserId], references: [id], onDelete: Cascade)
  domain   TaxonomyDomain    @relation(fields: [domainId], references: [id])
  category TaxonomyCategory? @relation(fields: [categoryId], references: [id])

  responses   GigResponse[]
  assignments GigAssignment[]
  tags        GigTag[]
  media       GigMedia[]

  thread Thread?

  @@index([posterUserId])
  @@index([status, visibility])
  @@index([domainId])
  @@index([categoryId])
  @@index([city, state, country])
  @@index([remoteOk])
  @@map("gigs")
  @@schema("app")
}

model GigTag {
  gigId      String    @map("gig_id") @db.Uuid
  tagId      String    @map("tag_id") @db.Uuid
  source     TagSource @default(user)
  confidence Float?
  verified   Boolean   @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  gig Gig         @relation(fields: [gigId], references: [id], onDelete: Cascade)
  tag TaxonomyTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([gigId, tagId])
  @@index([tagId])
  @@index([source])
  @@index([verified])
  @@map("gig_tags")
  @@schema("app")
}

model GigResponse {
  id                    String  @id @default(uuid()) @db.Uuid
  gigId                 String  @map("gig_id") @db.Uuid
  responderUserId       String? @map("responder_user_id") @db.Uuid
  professionalProfileId String  @map("professional_profile_id") @db.Uuid

  message       String?
  proposedCents Int?    @map("proposed_cents")
  currency      String  @default("usd")
  estimatedDays Int?    @map("estimated_days")

  status GigResponseStatus @default(submitted)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gig                 Gig                 @relation(fields: [gigId], references: [id], onDelete: Cascade)
  responderUser       User?               @relation("GigResponderUser", fields: [responderUserId], references: [id])
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  assignment GigAssignment?
  thread     Thread?

  @@unique([gigId, professionalProfileId])
  @@index([professionalProfileId, status])
  @@index([responderUserId])
  @@index([status])
  @@map("gig_responses")
  @@schema("app")
}

model GigAssignment {
  id                    String  @id @default(uuid()) @db.Uuid
  gigId                 String  @map("gig_id") @db.Uuid
  gigResponseId         String? @unique @map("gig_response_id") @db.Uuid
  professionalProfileId String  @map("professional_profile_id") @db.Uuid
  buyerUserId           String  @map("buyer_user_id") @db.Uuid
customerProfileId String? @map("customer_profile_id") @db.Uuid
customerProfile CustomerProfile? @relation("CustomerProfileGigAssignments", fields: [customerProfileId], references: [id])
  status GigAssignmentStatus @default(proposed)

  title       String?
  description String?

  agreedPriceCents Int?   @map("agreed_price_cents")
  currency         String @default("usd")

  startsAt    DateTime? @map("starts_at")
  dueAt       DateTime? @map("due_at")
  deliveredAt DateTime? @map("delivered_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gig                 Gig                 @relation(fields: [gigId], references: [id], onDelete: Cascade)
  gigResponse         GigResponse?        @relation(fields: [gigResponseId], references: [id])
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  order  Order?
  thread Thread?

  @@index([gigId])
  @@index([professionalProfileId])
  @@index([buyerUserId])
  @@index([status])
  @@map("gig_assignments")
  @@schema("app")
}

/**
 * =========================================================
 * FORMAL HIRING
 * Organizations post Jobs.
 * Candidates apply to Jobs.
 * Jobs are not Gigs.
 * Jobs are not Offerings.
 * =========================================================
 */

model Job {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  title          String
  description    String
  status         JobStatus      @default(draft)
  visibility     JobVisibility  @default(public)
  employmentType EmploymentType @map("employment_type")

  domainId   String  @map("domain_id") @db.Uuid
  categoryId String? @map("category_id") @db.Uuid

  location String?
  city     String?
  state    String?
  country  String?
  remoteOk Boolean @default(false) @map("remote_ok")
  compensationMinCents Int?   @map("compensation_min_cents")
  compensationMaxCents Int?   @map("compensation_max_cents")
  currency             String @default("usd")
  compensationPeriod CompensationPeriod? @map("compensation_period")
    compensationDisclosure JobCompensationDisclosure?
  complianceStatus   JobComplianceStatus @default(not_checked) @map("compliance_status")
  complianceChecks   JobComplianceCheck[]

  publishedAt        DateTime?           @map("published_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  closesAt  DateTime? @map("closes_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain       TaxonomyDomain    @relation(fields: [domainId], references: [id])
  category     TaxonomyCategory? @relation(fields: [categoryId], references: [id])

  applications JobApplication[]
  tags         JobTag[]
  media        JobMedia[]

  @@index([organizationId, visibility, status])
  @@index([employmentType, city, state, country])
  @@index([domainId])
  @@index([categoryId])
  @@map("jobs")
  @@schema("app")
}

model JobCompensationDisclosure {
  id                    String                          @id @default(uuid()) @db.Uuid
  jobId                 String                          @unique @map("job_id") @db.Uuid

  status                JobCompensationDisclosureStatus @default(not_required)

  jurisdictionCountry   String?                         @map("jurisdiction_country")
  jurisdictionState     String?                         @map("jurisdiction_state")
  jurisdictionCity      String?                         @map("jurisdiction_city")
  ruleKey               String?                         @map("rule_key")
  ruleVersion           String?                         @map("rule_version")

  compensationMinCents  Int?                            @map("compensation_min_cents")
  compensationMaxCents  Int?                            @map("compensation_max_cents")
  currency              String                          @default("usd")
  compensationPeriod    CompensationPeriod?             @map("compensation_period")

  benefitsDescription   String?                         @map("benefits_description")
  bonusDescription      String?                         @map("bonus_description")
  commissionDescription String?                         @map("commission_description")
  equityDescription     String?                         @map("equity_description")
  tipsDescription       String?                         @map("tips_description")

  remoteRole            Boolean                         @default(false) @map("remote_role")
  locationBasedRule     Boolean                         @default(false) @map("location_based_rule")

  checkedAt             DateTime?                       @map("checked_at")
  createdAt             DateTime                        @default(now()) @map("created_at")
  updatedAt             DateTime                        @updatedAt @map("updated_at")

  job                   Job                             @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([jurisdictionCountry, jurisdictionState, jurisdictionCity])
  @@index([ruleKey, ruleVersion])
  @@map("job_compensation_disclosures")
  @@schema("app")
}

model JobApplication {
  id                 String @id @default(uuid()) @db.Uuid
  jobId              String @map("job_id") @db.Uuid
  candidateProfileId String @map("candidate_profile_id") @db.Uuid

  coverLetter String? @map("cover_letter")
  answers     Json?
  invited     Boolean @default(false)

  status JobApplicationStatus @default(submitted)
  stage  JobApplicationStage  @default(new_)
  interviews JobInterview[]

  submittedAt DateTime  @default(now()) @map("submitted_at")
  viewedAt    DateTime? @map("viewed_at")
  offerAt     DateTime? @map("offer_at")
  hiredAt     DateTime? @map("hired_at")
  rejectedAt  DateTime? @map("rejected_at")
  withdrawnAt DateTime? @map("withdrawn_at")

  job              Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  media              JobApplicationMedia[]
  resumeParseResults ResumeParseResult[]
  resumeAccessLogs   ResumeAccessLog[]
  thread Thread?

  @@unique([jobId, candidateProfileId])
  @@index([jobId, status, stage])
  @@index([candidateProfileId, status])
  @@map("job_applications")
  @@schema("app")
  jobApplicationViewEvents JobApplicationViewEvent[]
}

model JobApplicationViewEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  jobApplicationId   String   @map("job_application_id") @db.Uuid
  viewedByUserId     String?  @map("viewed_by_user_id") @db.Uuid
  organizationId     String?  @map("organization_id") @db.Uuid

  viewedAt           DateTime @default(now()) @map("viewed_at")
  ipHash             String?  @map("ip_hash")
  userAgent          String?  @map("user_agent")

  jobApplication     JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  viewedByUser       User?          @relation(fields: [viewedByUserId], references: [id])
  organization       Organization?  @relation(fields: [organizationId], references: [id])

  @@index([jobApplicationId, viewedAt])
  @@index([viewedByUserId, viewedAt])
  @@index([organizationId, viewedAt])
  @@map("job_application_view_events")
  @@schema("app")
  organizations Organization[] @relation("OrganizationJobApplicationViewEvents")
}

model JobInterview {
  id                       String                  @id @default(uuid()) @db.Uuid

  jobApplicationId          String                  @map("job_application_id") @db.Uuid
  organizationId            String                  @map("organization_id") @db.Uuid
  candidateProfileId        String                  @map("candidate_profile_id") @db.Uuid
  scheduledByUserId         String?                 @map("scheduled_by_user_id") @db.Uuid

  status                    JobInterviewStatus      @default(draft)
  locationType              JobInterviewLocationType @map("location_type")

  startsAt                  DateTime                @map("starts_at")
  endsAt                    DateTime                @map("ends_at")

  candidateTimezone         String?                 @map("candidate_timezone")
  organizationTimezone      String?                 @map("organization_timezone")

  locationText              String?                 @map("location_text")
  externalMeetingUrl String? @map("external_meeting_url")

  rescheduledFromInterviewId String?                @map("rescheduled_from_interview_id") @db.Uuid

  externalCalendarEventId   String?                 @map("external_calendar_event_id")
  externalCalendarProvider  CalendarIntegrationProvider? @map("external_calendar_provider")
  externalSyncStatus        CalendarEventSyncStatus @default(pending) @map("external_sync_status")
  externalSyncError         String?                 @map("external_sync_error")

  cancelledAt               DateTime?               @map("cancelled_at")
  completedAt               DateTime?               @map("completed_at")
  noShowAt                  DateTime?               @map("no_show_at")

  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")

  jobApplication            JobApplication          @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  organization              Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateProfile          CandidateProfile        @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  scheduledByUser           User?                   @relation("ScheduledJobInterviews", fields: [scheduledByUserId], references: [id])

  rescheduledFromInterview  JobInterview?           @relation("JobInterviewReschedules", fields: [rescheduledFromInterviewId], references: [id])
  rescheduledToInterviews   JobInterview[]          @relation("JobInterviewReschedules")

  participants              JobInterviewParticipant[]
  events                    JobInterviewEvent[]
  videoRoom                 JobInterviewVideoRoom?
  thread                    Thread?

  @@index([jobApplicationId])
  @@index([organizationId, status])
  @@index([candidateProfileId, status])
  @@index([scheduledByUserId])
  @@index([startsAt, endsAt])
  @@index([externalCalendarProvider, externalCalendarEventId])
  @@index([externalSyncStatus])
  @@map("job_interviews")
  @@schema("app")
}

model JobInterviewParticipant {
  interviewId String                        @map("interview_id") @db.Uuid
  userId      String                        @map("user_id") @db.Uuid

  role        JobInterviewParticipantRole
  status      JobInterviewParticipantStatus @default(invited)

  invitedAt   DateTime                      @default(now()) @map("invited_at")
  respondedAt DateTime?                     @map("responded_at")

  interview   JobInterview                  @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user        User                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([interviewId, userId])
  @@index([userId, status])
  @@index([role])
  @@map("job_interview_participants")
  @@schema("app")
}

model JobInterviewEvent {
  id          String                  @id @default(uuid()) @db.Uuid
  interviewId String                  @map("interview_id") @db.Uuid

  actor       JobInterviewEventActor
  actorId     String?                 @map("actor_id") @db.Uuid

  fromStatus  JobInterviewStatus?     @map("from_status")
  toStatus    JobInterviewStatus?     @map("to_status")

  name        String
  reason      String?
  metadata    Json?

  createdAt   DateTime                @default(now()) @map("created_at")

  interview   JobInterview            @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId, createdAt])
  @@index([actor])
  @@index([name])
  @@map("job_interview_events")
  @@schema("app")
}

model JobInterviewVideoRoom {
  id                  String                      @id @default(uuid()) @db.Uuid
  interviewId          String                      @unique @map("interview_id") @db.Uuid

  provider            JobInterviewVideoProvider   @default(daily)
  status              JobInterviewVideoRoomStatus @default(pending)

  providerRoomId      String?                     @map("provider_room_id")
  roomUrl             String?                     @map("room_url")
  candidateJoinUrl    String?                     @map("candidate_join_url")
  interviewerJoinUrl  String?                     @map("interviewer_join_url")

  startsAt            DateTime?                   @map("starts_at")
  endsAt              DateTime?                   @map("ends_at")
  expiresAt           DateTime?                   @map("expires_at")

  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  failedAt            DateTime?                   @map("failed_at")
  failureReason       String?                     @map("failure_reason")

  interview           JobInterview                @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([provider, status])
  @@index([providerRoomId])
  @@index([expiresAt])
  @@map("job_interview_video_rooms")
  @@schema("app")
}

model JobTag {
  jobId      String    @map("job_id") @db.Uuid
  tagId      String    @map("tag_id") @db.Uuid
  source     TagSource @default(user)
  confidence Float?
  verified   Boolean   @default(false)

  createdAt DateTime @default(now()) @map("created_at")


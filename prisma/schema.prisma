  entityType  SearchEntityType @map("entity_type")
  entityId    String           @map("entity_id") @db.Uuid
  reason      String?
  processed   Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at")
  processedAt DateTime?        @map("processed_at")

  @@index([entityType, entityId, createdAt])
  @@index([processed, createdAt])
  @@map("search_upsert_events")
  @@schema("app")
}

model ProcessedStripeEvent {
  eventId    String   @id @map("event_id")
  type       String
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([type, receivedAt])
  @@map("processed_stripe_events")
  @@schema("app")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  action      String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_events")
  @@schema("app")
}

/**
 * =========================================================
 * NOTIFICATION
 * =========================================================
 */

model Notification {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String?              @map("user_id") @db.Uuid
  organizationId String?              @map("organization_id") @db.Uuid

  channel        NotificationChannel
  name           String
  priority       NotificationPriority @default(normal)

  title          String?
  body           String?
  actionUrl      String?              @map("action_url")

  status         NotificationStatus   @default(queued)
  payload        Json?

  createdAt      DateTime             @default(now()) @map("created_at")
  readAt         DateTime?            @map("read_at")
  clickedAt      DateTime?            @map("clicked_at")

  user           User?                @relation(fields: [userId], references: [id])
  organization   Organization?        @relation(fields: [organizationId], references: [id])
  deliveries     NotificationDelivery[]
    sourceType             String?                         @map("source_type")
  sourceId               String?                         @map("source_id") @db.Uuid

  payloadSensitivity     NotificationPayloadSensitivity  @default(safe) @map("payload_sensitivity")
  safePreviewOnly        Boolean                         @default(true) @map("safe_preview_only")

  expiresAt              DateTime?                       @map("expires_at")
  subscriptionEvents NotificationSubscriptionEvent[] @relation("NotificationSubscriptionEvents")
  @@index([userId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([channel, status])
  @@index([name, createdAt])
    @@index([sourceType, sourceId])
  @@index([payloadSensitivity, createdAt])
  @@index([expiresAt])
  @@map("notifications")
  @@schema("app")
}

model NotificationSubscription {
  id             String                         @id @default(uuid()) @db.Uuid
  userId         String                         @map("user_id") @db.Uuid

  provider       NotificationSubscriptionProvider
  platform       NotificationPlatform           @default(unknown)
  status         NotificationSubscriptionStatus @default(active)

  endpoint       String?
  token          String?
  p256dh         String?
  auth           String?

  userAgent      String?                        @map("user_agent")
  deviceLabel    String?                        @map("device_label")

  isIosPwa       Boolean                        @default(false) @map("is_ios_pwa")
  appInstalled   Boolean                        @default(false) @map("app_installed")

  lastSeenAt     DateTime?                      @map("last_seen_at")
  revokedAt      DateTime?                      @map("revoked_at")
  failedAt       DateTime?                      @map("failed_at")
  failureReason  String?                        @map("failure_reason")

  createdAt      DateTime                       @default(now()) @map("created_at")
  updatedAt      DateTime                       @updatedAt @map("updated_at")

  user           User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries     NotificationDelivery[]
    permissionStatus       NotificationPermissionStatus @default(not_requested) @map("permission_status")

  endpointHash           String?                      @map("endpoint_hash")
  tokenHash              String?                      @map("token_hash")

  endpointEncrypted      String?                      @map("endpoint_encrypted")
  tokenEncrypted         String?                      @map("token_encrypted")
  p256dhEncrypted        String?                      @map("p256dh_encrypted")
  authEncrypted          String?                      @map("auth_encrypted")

  serviceWorkerScope     String?                      @map("service_worker_scope")
  serviceWorkerVersion   String?                      @map("service_worker_version")
  vapidKeyId             String?                      @map("vapid_key_id")

  pwaInstallStatus       PwaInstallStatus             @default(unknown) @map("pwa_install_status")
  manifestVersion        String?                      @map("manifest_version")

  permissionRequestedAt  DateTime?                    @map("permission_requested_at")
  permissionGrantedAt    DateTime?                    @map("permission_granted_at")
  permissionDeniedAt     DateTime?                    @map("permission_denied_at")

  lastDeliveryAttemptAt  DateTime?                    @map("last_delivery_attempt_at")
  failureCode            String?                      @map("failure_code")
  failureCount           Int                          @default(0) @map("failure_count")

  unsubscribedAt         DateTime?                    @map("unsubscribed_at")
  events NotificationSubscriptionEvent[]
  @@unique([provider, endpoint])
  @@unique([provider, token])
  @@index([userId, status])
  @@index([provider, status])
  @@index([platform, status])
    @@index([permissionStatus])
  @@index([endpointHash])
  @@index([tokenHash])
  @@index([pwaInstallStatus])
  @@index([lastDeliveryAttemptAt])
  @@map("notification_subscriptions")
  @@schema("app")
}

model NotificationDelivery {
  id                     String                     @id @default(uuid()) @db.Uuid
  notificationId          String                     @map("notification_id") @db.Uuid
  subscriptionId          String?                    @map("subscription_id") @db.Uuid

  channel                 NotificationChannel
  provider                NotificationSubscriptionProvider?
  status                  NotificationDeliveryStatus @default(queued)

  providerMessageId       String?                    @map("provider_message_id")
  failureReason           String?                    @map("failure_reason")

  queuedAt                DateTime                   @default(now()) @map("queued_at")
  sentAt                  DateTime?                  @map("sent_at")
  deliveredAt             DateTime?                  @map("delivered_at")
  failedAt                DateTime?                  @map("failed_at")
  clickedAt               DateTime?                  @map("clicked_at")

  notification            Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscription            NotificationSubscription?   @relation(fields: [subscriptionId], references: [id])
  providerErrorCode      String?   @map("provider_error_code")
  providerErrorType      String?   @map("provider_error_type")
  shouldDisableSubscription Boolean @default(false) @map("should_disable_subscription")

  clickedUrl             String?   @map("clicked_url")
  openedAt               DateTime? @map("opened_at")
  closedAt               DateTime? @map("closed_at")
  subscriptionEvents NotificationSubscriptionEvent[] @relation("NotificationDeliverySubscriptionEvents")
  @@index([notificationId])
  @@index([subscriptionId])
  @@index([channel, status])
  @@index([provider, status])
    @@index([providerErrorCode])
  @@index([shouldDisableSubscription, failedAt])
  @@map("notification_deliveries")
  @@schema("app")
}

/**

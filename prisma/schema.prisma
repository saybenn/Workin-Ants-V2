  gigAssignment GigAssignment? @relation(fields: [gigAssignmentId], references: [id])

  buyerUser                 User                @relation("BuyerUserOrders", fields: [buyerUserId], references: [id])
  sellerProfessionalProfile ProfessionalProfile @relation("ProfessionalSellerOrders", fields: [sellerProfessionalProfileId], references: [id])


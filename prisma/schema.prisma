// prisma/schema.prisma
// Workin Ants — Phase 2 Database Truth Layer
//
// Corrected model laws:
//
// User:
// - account holder
// - can post Gigs
// - can buy Offerings
// - can create CandidateProfile
// - can create ProfessionalProfile
// - can belong to Organizations
// - cannot sell Offerings directly
//
// ProfessionalProfile:
// - required seller identity
// - sells Offerings
// - responds to Gigs
// - receives Orders
//
// Organization:
// - hiring entity only
// - posts Jobs
// - does not sell Offerings
//
// CandidateProfile:
// - applies to Jobs
//
// Gig:
// - public paid request posted by a User
// - not an Offering
//
// Offering:
// - sellable product/service/course/bundle from a ProfessionalProfile
//
// Order:
// - paid transaction truth
//
// This schema intentionally avoids:
// - RLS policies
// - Stripe checkout implementation
// - Typesense indexing implementation
// - full messaging behavior
// - AI classification behavior
// - ranking/metrics systems
// - subscription/plans
// - duplicated SearchDoc table

datasource db {
  provider = "postgresql"
  schemas  = ["public", "app"]
}

generator client {
  provider = "prisma-client-js"
}


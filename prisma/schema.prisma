  @@index([source])
  @@index([externalEventId])
  @@map("busy_windows")
  @@schema("app")
}

/**
 * =========================================================
 * BOOKING ORCHESTRATION
 * Booking & Calendar owned.
 *
 * Records requests/results for downstream modules.
 * Does not own video rooms or agreements.
 * =========================================================
 */

model BookingOrchestrationRun {
  id                    String                    @id @default(uuid()) @db.Uuid

  bookingId             String                    @map("booking_id") @db.Uuid
  orderId               String?                   @map("order_id") @db.Uuid
  triggeredByUserId     String?                   @map("triggered_by_user_id") @db.Uuid

  status                BookingOrchestrationStatus @default(pending)

  triggerSource         String?                   @map("trigger_source")
  idempotencyKey        String?                   @unique @map("idempotency_key")

  startedAt             DateTime?                 @map("started_at")
  completedAt           DateTime?                 @map("completed_at")
  failedAt              DateTime?                 @map("failed_at")
  failureReason         String?                   @map("failure_reason")

  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  booking               Booking                   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  order                 Order?                    @relation("OrderBookingOrchestrationRuns", fields: [orderId], references: [id])
  triggeredByUser       User?                     @relation("UserBookingOrchestrationRuns", fields: [triggeredByUserId], references: [id])

  steps                 BookingOrchestrationStep[]

  @@index([bookingId, status])
  @@index([orderId])
  @@index([triggeredByUserId])
  @@index([status, createdAt])
  @@map("booking_orchestration_runs")
  @@schema("app")
}

model BookingOrchestrationStep {
  id                    String                         @id @default(uuid()) @db.Uuid

  runId                 String                         @map("run_id") @db.Uuid
  bookingId             String                         @map("booking_id") @db.Uuid

  type                  BookingOrchestrationStepType
  status                BookingOrchestrationStepStatus @default(pending)

  targetType            String?                        @map("target_type")
  targetId              String?                        @map("target_id") @db.Uuid

  provider              String?
  providerReferenceId   String?                        @map("provider_reference_id")

  attemptCount          Int                            @default(0) @map("attempt_count")
  lastAttemptAt         DateTime?                      @map("last_attempt_at")
  completedAt           DateTime?                      @map("completed_at")
  failedAt              DateTime?                      @map("failed_at")
  failureReason         String?                        @map("failure_reason")

  metadata              Json?

  createdAt             DateTime                       @default(now()) @map("created_at")
  updatedAt             DateTime                       @updatedAt @map("updated_at")

  run                   BookingOrchestrationRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  booking               Booking                        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@index([bookingId, type, status])
  @@index([targetType, targetId])
  @@index([provider, providerReferenceId])
  @@map("booking_orchestration_steps")
  @@schema("app")
}

model Booking {
  id                         String                       @id @default(uuid()) @db.Uuid

  orderId                    String                       @map("order_id") @db.Uuid

  buyerUserId                String                       @map("buyer_user_id") @db.Uuid
  professionalProfileId      String                       @map("professional_profile_id") @db.Uuid
customerProfileId String? @map("customer_profile_id") @db.Uuid
customerProfile CustomerProfile? @relation("CustomerProfileBookings", fields: [customerProfileId], references: [id])

prioritySchedulingApplied Boolean @default(false) @map("priority_scheduling_applied")
priorityEntitlementGrantId String? @map("priority_entitlement_grant_id") @db.Uuid
priorityRank Int? @map("priority_rank")
  status                     BookingStatus                @default(draft)
  locationType               BookingLocationType          @map("location_type")
  locationPrecision          LocationPrecision    @default(public_fuzzy) @map("location_precision")
  locationRevealStatus        LocationRevealStatus @default(hidden) @map("location_reveal_status")
  exactAddressEncrypted       String?              @map("exact_address_encrypted")
  fuzzyLat                    Float?               @map("fuzzy_lat")
  fuzzyLng                    Float?               @map("fuzzy_lng")

  slotStartAt                DateTime                     @map("slot_start_at")
  slotEndAt                  DateTime                     @map("slot_end_at")


  cancellationDeadlineAt     DateTime?                    @map("cancellation_deadline_at")

  cancelledAt                DateTime?                    @map("cancelled_at")
  completedAt                DateTime?                    @map("completed_at")
  noShowAt                   DateTime?                    @map("no_show_at")

  rescheduledFromBookingId   String?                      @map("rescheduled_from_booking_id") @db.Uuid

  externalCalendarEventId    String?                      @map("external_calendar_event_id")
  externalCalendarProvider   CalendarIntegrationProvider? @map("external_calendar_provider")
  externalSyncStatus         CalendarEventSyncStatus      @default(pending) @map("external_sync_status")
  externalSyncError          String?                      @map("external_sync_error")

  createdAt                  DateTime                     @default(now()) @map("created_at")
  updatedAt                  DateTime                     @updatedAt @map("updated_at")

  order                      Order                        @relation(fields: [orderId], references: [id])
  buyerUser                  User                         @relation("BuyerBookings", fields: [buyerUserId], references: [id])
  professionalProfile        ProfessionalProfile          @relation("ProfessionalBookings", fields: [professionalProfileId], references: [id])

  rescheduledFromBooking     Booking?                     @relation("BookingReschedules", fields: [rescheduledFromBookingId], references: [id])
  rescheduledToBookings      Booking[]                    @relation("BookingReschedules")

  events                     BookingEvent[]
  videoRoom                  BookingVideoRoom?

    calendarConnectionId     String?   @map("calendar_connection_id") @db.Uuid
  bookingHoldId            String?   @unique @map("booking_hold_id") @db.Uuid
  slotLockId               String?   @map("slot_lock_id") @db.Uuid

  buyerTimezone            String?   @map("buyer_timezone")
  professionalTimezone     String?   @map("professional_timezone")

  providerEventId          String?   @map("provider_event_id")
  providerCalendarId       String?   @map("provider_calendar_id")
  providerEventUid         String?   @map("provider_event_uid")
  providerEventVersion     String?   @map("provider_event_version")

  videoRoomRequestedAt     DateTime? @map("video_room_requested_at")
  agreementRequestedAt     DateTime? @map("agreement_requested_at")
  confirmationSentAt       DateTime? @map("confirmation_sent_at")

  overtimeGraceMinutes     Int      @default(15) @map("overtime_grace_minutes")

  calendarConnection       CalendarConnection? @relation(fields: [calendarConnectionId], references: [id])
  bookingHold              BookingHold?        @relation(fields: [bookingHoldId], references: [id])
  slotLock                 BookingSlotLock?    @relation(fields: [slotLockId], references: [id])
  orchestrationRuns       BookingOrchestrationRun[]
  orchestrationSteps      BookingOrchestrationStep[]
  processedCalendarEvents ProcessedCalendarEvent[]
  @@index([orderId])
  @@index([buyerUserId, status])
  @@index([professionalProfileId, slotStartAt, slotEndAt])
  @@index([professionalProfileId, status])
  @@index([slotStartAt, slotEndAt])
  @@index([externalCalendarProvider, externalCalendarEventId])
  @@index([externalSyncStatus])
    @@index([calendarConnectionId])
  @@index([bookingHoldId])
  @@index([slotLockId])
  @@index([providerEventId])
  @@map("bookings")
  @@schema("app")
}

model BookingHold {
  id                    String              @id @default(uuid()) @db.Uuid

  orderId               String?             @map("order_id") @db.Uuid
  buyerUserId           String              @map("buyer_user_id") @db.Uuid
  professionalProfileId String              @map("professional_profile_id") @db.Uuid
customerProfileId String? @map("customer_profile_id") @db.Uuid
customerProfile CustomerProfile? @relation("CustomerProfileBookingHolds", fields: [customerProfileId], references: [id])

prioritySchedulingApplied Boolean @default(false) @map("priority_scheduling_applied")
priorityEntitlementGrantId String? @map("priority_entitlement_grant_id") @db.Uuid
priorityRank Int? @map("priority_rank")
  status                BookingHoldStatus   @default(active)

  slotStartAt           DateTime            @map("slot_start_at")
  slotEndAt             DateTime            @map("slot_end_at")


  expiresAt             DateTime            @map("expires_at")
  convertedAt           DateTime?           @map("converted_at")
  releasedAt            DateTime?           @map("released_at")

  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  order                 Order?              @relation(fields: [orderId], references: [id])
  buyerUser             User                @relation("BuyerBookingHolds", fields: [buyerUserId], references: [id])
  professionalProfile   ProfessionalProfile @relation("ProfessionalBookingHolds", fields: [professionalProfileId], references: [id])

  booking               Booking?
  lockId                  String?   @map("lock_id") @db.Uuid
  buyerTimezone           String?   @map("buyer_timezone")
  professionalTimezone    String?   @map("professional_timezone")

  selectedAt              DateTime? @map("selected_at")
  paymentStartedAt        DateTime? @map("payment_started_at")
  agreementStartedAt      DateTime? @map("agreement_started_at")

  providerAvailabilityHash String?  @map("provider_availability_hash")
    slotLock BookingSlotLock? @relation("BookingHoldSlotLock")
  @@index([orderId])
  @@index([buyerUserId, status])
  @@index([professionalProfileId, slotStartAt, slotEndAt, status])
  @@index([expiresAt, status])
  @@map("booking_holds")
  @@schema("app")
}

model BookingEvent {
  id          String             @id @default(uuid()) @db.Uuid
  bookingId   String             @map("booking_id") @db.Uuid

  actor       BookingEventActor
  actorId     String?            @map("actor_id") @db.Uuid

  fromStatus  BookingStatus?     @map("from_status")
  toStatus    BookingStatus?     @map("to_status")

  name        String
  reason      String?
  metadata    Json?

  createdAt   DateTime           @default(now()) @map("created_at")

  booking     Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([actor])
  @@index([name])
  @@map("booking_events")
  @@schema("app")
}

model BookingVideoRoom {
  id                    String                 @id @default(uuid()) @db.Uuid
  bookingId             String                 @unique @map("booking_id") @db.Uuid

  provider              BookingVideoProvider   @default(daily)
  status                BookingVideoRoomStatus @default(pending)

  providerRoomId        String?                @map("provider_room_id")
  roomUrl               String?                @map("room_url")
  buyerJoinUrl          String?                @map("buyer_join_url")
  professionalJoinUrl   String?                @map("professional_join_url")

  startsAt              DateTime?              @map("starts_at")
  endsAt                DateTime?              @map("ends_at")
  expiresAt             DateTime?              @map("expires_at")

  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  failedAt              DateTime?              @map("failed_at")
  failureReason         String?                @map("failure_reason")

  booking               Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([provider, status])
  @@index([providerRoomId])
  @@index([expiresAt])
  @@map("booking_video_rooms")
  @@schema("app")
}
model ProcessedCalendarEvent {
  id                    String                     @id @default(uuid()) @db.Uuid

  provider              CalendarIntegrationProvider @default(cronofy)
  providerEventId       String                     @map("provider_event_id")
  providerEventType     CalendarProviderEventType? @map("provider_event_type")
  status                CalendarProviderEventStatus @default(received)

  calendarConnectionId  String?                    @map("calendar_connection_id") @db.Uuid
  professionalProfileId String?                    @map("professional_profile_id") @db.Uuid
  bookingId             String?                    @map("booking_id") @db.Uuid

  payloadHash           String?                    @map("payload_hash")
  requestId             String?                    @map("request_id")

  receivedAt            DateTime                   @default(now()) @map("received_at")
  processedAt           DateTime?                  @map("processed_at")
  failedAt              DateTime?                  @map("failed_at")
  failureReason         String?                    @map("failure_reason")

  calendarConnection    CalendarConnection?        @relation(fields: [calendarConnectionId], references: [id])
  professionalProfile   ProfessionalProfile?       @relation("ProfessionalProcessedCalendarEvents", fields: [professionalProfileId], references: [id])
  booking               Booking?                   @relation(fields: [bookingId], references: [id])

  @@unique([provider, providerEventId])
  @@index([calendarConnectionId])
  @@index([professionalProfileId])
  @@index([bookingId])
  @@index([status, receivedAt])
  @@map("processed_calendar_events")
  @@schema("app")
}

/**
 * =========================================================
 * MESSAGING
 * Shell only. Full behavior comes later.
 * =========================================================
 */

model Thread {
  id          String            @id @default(uuid()) @db.Uuid
  contextType ThreadContextType @map("context_type")
  contextId   String?           @map("context_id") @db.Uuid

  orderId          String? @unique @map("order_id") @db.Uuid
  gigId            String? @unique @map("gig_id") @db.Uuid
  gigResponseId    String? @unique @map("gig_response_id") @db.Uuid
  gigAssignmentId  String? @unique @map("gig_assignment_id") @db.Uuid
  jobApplicationId String? @unique @map("job_application_id") @db.Uuid
  jobInterviewId   String? @unique @map("job_interview_id") @db.Uuid


  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order          Order?          @relation(fields: [orderId], references: [id])
  gig            Gig?            @relation(fields: [gigId], references: [id])
  gigResponse    GigResponse?    @relation(fields: [gigResponseId], references: [id])
  gigAssignment  GigAssignment?  @relation(fields: [gigAssignmentId], references: [id])
  jobApplication JobApplication? @relation(fields: [jobApplicationId], references: [id])
  jobInterview   JobInterview?   @relation(fields: [jobInterviewId], references: [id])
  
  participants ThreadParticipant[]
  messages     Message[]
  dataSensitivity DataSensitivity @default(normal) @map("data_sensitivity")
  erasedAt        DateTime?       @map("erased_at")

  @@index([contextType, contextId])
  @@map("threads")
  @@schema("app")
}

model ThreadParticipant {
  threadId String @map("thread_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  joinedAt   DateTime  @default(now()) @map("joined_at")
  lastReadAt DateTime? @map("last_read_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId])
  @@map("thread_participants")
  @@schema("app")
}

model Message {
  id        String    @id @default(uuid()) @db.Uuid
  threadId  String    @map("thread_id") @db.Uuid
  senderId  String?   @map("sender_id") @db.Uuid
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at")
  deletedAt DateTime? @map("deleted_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User?  @relation(fields: [senderId], references: [id])

  media MessageMedia[]
  erasedAt DateTime? @map("erased_at")


  @@index([threadId, createdAt])
  @@index([senderId])
  @@map("messages")
  @@schema("app")
}

model MessageMedia {
  messageId String @map("message_id") @db.Uuid
  mediaId   String @map("media_id") @db.Uuid

  message Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([messageId, mediaId])
  @@index([mediaId])
  @@map("message_media")
  @@schema("app")
}

/**
 * =========================================================
 * INTEGRATION / INFRA EVENTS
 * =========================================================
 */

model SearchUpsertEvent {

/**
 * =========================================================
 * MARKETPLACE SUPPLY: OFFERINGS
 * Offerings are sellable things created only by ProfessionalProfiles.
 * =========================================================
 */

model Offering {
  id          String         @id @default(uuid()) @db.Uuid
  kind        OfferingKind
  slug        String
  title       String
  summary     String?
  description String?
  status      OfferingStatus @default(draft)

  professionalProfileId String @map("professional_profile_id") @db.Uuid

  domainId   String  @map("domain_id") @db.Uuid
  categoryId String? @map("category_id") @db.Uuid

  priceFromCents Int?   @map("price_from_cents")
  currency       String @default("usd")

  isFeatured Boolean @default(false) @map("is_featured")
  isPublic   Boolean @default(true) @map("is_public")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  domain              TaxonomyDomain      @relation(fields: [domainId], references: [id])
  category            TaxonomyCategory?   @relation(fields: [categoryId], references: [id])

  serviceDetails ServiceDetails?
  productDetails ProductDetails?
  courseDetails  CourseDetails?

  pricingTiers PricingTier[]
  media        OfferingMedia[]
  tags         OfferingTag[]
  orders       Order[]

    frozenAt     DateTime? @map("frozen_at")
  hiddenAt     DateTime? @map("hidden_at")
  takedownAt   DateTime? @map("takedown_at")

  requiresHealthcareCompliance Boolean         @default(false) @map("requires_healthcare_compliance")
  dataSensitivity              DataSensitivity @default(normal) @map("data_sensitivity")
  digitalGoodsPolicy            DigitalGoodsPolicy?             @relation("OfferingDigitalGoodsPolicy")
  digitalGoodsTermsAcceptances  DigitalGoodsTermsAcceptance[]   @relation("OfferingDigitalGoodsTermsAcceptances")
  digitalDownloadAssets         DigitalDownloadAsset[]          @relation("OfferingDigitalDownloadAssets")
  childDirectedDeclarations     ChildDirectedContentDeclaration[] @relation("OfferingChildDirectedDeclarations")
  minorPrivacyControls          MinorPrivacyControl[]           @relation("OfferingMinorPrivacyControls")
  salesTaxLineItems             SalesTaxLineItem[]              @relation("OfferingSalesTaxLineItems")
  courseAccessibilityAssets     CourseAccessibilityAsset[]      @relation("OfferingCourseAccessibilityAssets")
  @@unique([professionalProfileId, slug])
  @@index([kind, status])
  @@index([professionalProfileId])
  @@index([domainId])
  @@index([categoryId])
  @@map("offerings")
  @@schema("app")
}

model ServiceDetails {
  offeringId        String              @id @map("offering_id") @db.Uuid
  deliveryMode      ServiceDeliveryMode @map("delivery_mode")
  durationMinutes   Int?                @map("duration_minutes")
  minStartDelayDays Int?                @map("min_start_delay_days")
  bookingBufferMin  Int?                @default(15) @map("booking_buffer_min")

  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@map("service_details")
  @@schema("app")
}

model ProductDetails {
  offeringId   String              @id @map("offering_id") @db.Uuid
  deliveryMode ProductDeliveryMode @map("delivery_mode")
  fileAssetId  String?             @map("file_asset_id") @db.Uuid
  externalUrl  String?             @map("external_url")

  offering  Offering    @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  fileAsset MediaAsset? @relation(fields: [fileAssetId], references: [id])
  digitalDownloadAssets DigitalDownloadAsset[] @relation("ProductDetailsDigitalDownloadAssets")
  @@map("product_details")
  @@schema("app")
}

model CourseDetails {
  offeringId             String             @id @map("offering_id") @db.Uuid
  deliveryMode           CourseDeliveryMode @map("delivery_mode")
  courseLengthMinutes    Int?               @map("course_length_minutes")
  lessonCount            Int?               @map("lesson_count")
  startsAt               DateTime?          @map("starts_at")
  endsAt                 DateTime?          @map("ends_at")
  enrollmentLimit        Int?               @map("enrollment_limit")
  externalUrl            String?            @map("external_url")
  accessExpiresAfterDays Int?               @map("access_expires_after_days")
    videoAssets CourseVideoAsset[] @relation("CourseVideoAssets")
  digitalDownloadAssets     DigitalDownloadAsset[]      @relation("CourseDetailsDigitalDownloadAssets")
  accessibilityAssets       CourseAccessibilityAsset[]  @relation("CourseDetailsAccessibilityAssets")
  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@map("course_details")
  @@schema("app")
}

model PricingTier {

  professionalProfileId String                 @map("professional_profile_id") @db.Uuid

  source                AvailabilityRuleSource @default(manual)
  externalRuleId         String?                @map("external_rule_id")

  weekday               Int
  startTime             String                 @map("start_time")
  endTime               String                 @map("end_time")
  timezone              String                 @default("UTC")

  effectiveFrom         DateTime?              @map("effective_from")
  effectiveUntil        DateTime?              @map("effective_until")

  isActive              Boolean                @default(true) @map("is_active")

  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  professionalProfile   ProfessionalProfile    @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@unique([professionalProfileId, weekday, startTime, endTime, timezone])
  @@index([professionalProfileId, isActive])
  @@index([weekday])
  @@index([source])
  @@map("availability_rules")
  @@schema("app")
}

model BusyWindow {
  id                    String              @id @default(uuid()) @db.Uuid
  professionalProfileId String              @map("professional_profile_id") @db.Uuid
  calendarConnectionId  String?             @map("calendar_connection_id") @db.Uuid

  source                BusyWindowSource
  sourceReferenceId     String?             @map("source_reference_id")
  externalEventId       String?             @map("external_event_id")

  startAt               DateTime            @map("start_at")
  endAt                 DateTime            @map("end_at")
  timezone              String?

  isPrivate             Boolean             @default(true) @map("is_private")

  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  calendarConnection    CalendarConnection? @relation(fields: [calendarConnectionId], references: [id])
  providerEventId          String?   @map("provider_event_id")
  providerCalendarId       String?   @map("provider_calendar_id")
  providerEventVersion     String?   @map("provider_event_version")

  sourceStartsAtUtc        DateTime? @map("source_starts_at_utc")
  sourceEndsAtUtc          DateTime? @map("source_ends_at_utc")

  freeBusyOnly             Boolean   @default(true) @map("free_busy_only")

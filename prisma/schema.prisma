  productDetails             ProductDetails?            @relation("ProductDetailsDigitalDownloadAssets", fields: [productDetailsOfferingId], references: [offeringId])
  courseDetails              CourseDetails?             @relation("CourseDetailsDigitalDownloadAssets", fields: [courseDetailsOfferingId], references: [offeringId])
  mediaAsset                 MediaAsset                 @relation("DigitalDownloadMediaAsset", fields: [mediaAssetId], references: [id])
  createdByUser              User?                      @relation("CreatedDigitalDownloadAssets", fields: [createdByUserId], references: [id])

  grants                     DigitalDownloadGrant[]
  events                     DigitalDownloadEvent[]

  @@index([offeringId, status])
  @@index([productDetailsOfferingId])
  @@index([courseDetailsOfferingId])
  @@index([mediaAssetId])
  @@index([provider, status])
  @@index([deletedAt])
  @@map("digital_download_assets")
  @@schema("app")
}

model DigitalDownloadGrant {
  id                    String                     @id @default(uuid()) @db.Uuid

  digitalDownloadAssetId String                    @map("digital_download_asset_id") @db.Uuid
  userId                String                     @map("user_id") @db.Uuid
  orderId               String?                    @map("order_id") @db.Uuid

  status                DigitalDownloadGrantStatus @default(active)

  tokenHash             String?                    @map("token_hash")
  presignedUrlHash      String?                    @map("presigned_url_hash")

  downloadCount         Int                        @default(0) @map("download_count")
  maxDownloads          Int?                       @map("max_downloads")

  deniedReason          String?                    @map("denied_reason")
  revokeReason          String?                    @map("revoke_reason")

  ipHash                String?                    @map("ip_hash")
  userAgent             String?                    @map("user_agent")

  grantedAt             DateTime                   @default(now()) @map("granted_at")
  firstUsedAt           DateTime?                  @map("first_used_at")
  lastUsedAt            DateTime?                  @map("last_used_at")
  expiresAt             DateTime                   @map("expires_at")
  revokedAt             DateTime?                  @map("revoked_at")

  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")

  digitalDownloadAsset  DigitalDownloadAsset       @relation(fields: [digitalDownloadAssetId], references: [id], onDelete: Cascade)
  user                  User                       @relation("UserDigitalDownloadGrants", fields: [userId], references: [id])
  order                 Order?                     @relation("OrderDigitalDownloadGrants", fields: [orderId], references: [id])

  events                DigitalDownloadEvent[]

  @@index([digitalDownloadAssetId, status])
  @@index([userId, grantedAt])
  @@index([orderId])
  @@index([expiresAt])
  @@index([tokenHash])
  @@map("digital_download_grants")
  @@schema("app")
}

model DigitalDownloadEvent {
  id                    String                   @id @default(uuid()) @db.Uuid

  digitalDownloadAssetId String                  @map("digital_download_asset_id") @db.Uuid
  digitalDownloadGrantId String?                 @map("digital_download_grant_id") @db.Uuid
  userId                String?                  @map("user_id") @db.Uuid
  orderId               String?                  @map("order_id") @db.Uuid

  type                  DigitalDownloadEventType

  provider              DigitalStorageProvider   @default(cloudflare_r2)
  providerRequestId     String?                  @map("provider_request_id")

  ipHash                String?                  @map("ip_hash")
  userAgent             String?                  @map("user_agent")
  metadata              Json?

  createdAt             DateTime                 @default(now()) @map("created_at")

  digitalDownloadAsset  DigitalDownloadAsset     @relation(fields: [digitalDownloadAssetId], references: [id], onDelete: Cascade)
  digitalDownloadGrant  DigitalDownloadGrant?    @relation(fields: [digitalDownloadGrantId], references: [id])
  user                  User?                    @relation("UserDigitalDownloadEvents", fields: [userId], references: [id])
  order                 Order?                   @relation("OrderDigitalDownloadEvents", fields: [orderId], references: [id])

  @@index([digitalDownloadAssetId, createdAt])
  @@index([digitalDownloadGrantId])
  @@index([userId, createdAt])
  @@index([orderId])
  @@index([type, createdAt])
  @@map("digital_download_events")
  @@schema("app")
}

/**
 * =========================================================
 * DIGITAL SALES TAX
 * Payment / Payout / Tax owned.
 *
 * This is sales/use/VAT transaction tax proof.
 * Do not confuse with TaxProfile / 1099 / seller income reporting.
 * =========================================================
 */

model SalesTaxCalculation {
  id                    String                    @id @default(uuid()) @db.Uuid

  orderId               String?                   @map("order_id") @db.Uuid
  userId                String?                   @map("user_id") @db.Uuid

  provider              SalesTaxProvider          @default(stripe_tax)
  status                SalesTaxCalculationStatus @default(draft)
  liabilityRole         SalesTaxLiabilityRole     @default(platform_marketplace_facilitator) @map("liability_role")

  providerCalculationId String?                   @map("provider_calculation_id")
  providerTransactionId String?                   @map("provider_transaction_id")

  buyerCountry          String?                   @map("buyer_country")
  buyerState            String?                   @map("buyer_state")
  buyerPostalCode       String?                   @map("buyer_postal_code")
  buyerCity             String?                   @map("buyer_city")

  currency              String                    @default("usd")
  taxableAmountCents    Int                       @default(0) @map("taxable_amount_cents")
  taxAmountCents        Int                       @default(0) @map("tax_amount_cents")
  totalAmountCents      Int                       @default(0) @map("total_amount_cents")

  exemptionReason       String?                   @map("exemption_reason")
  failureReason         String?                   @map("failure_reason")
  metadata              Json?

  calculatedAt          DateTime?                 @map("calculated_at")
  finalizedAt           DateTime?                 @map("finalized_at")
  voidedAt              DateTime?                 @map("voided_at")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  order                 Order?                    @relation("OrderSalesTaxCalculations", fields: [orderId], references: [id])
  user                  User?                     @relation("UserSalesTaxCalculations", fields: [userId], references: [id])
  lineItems             SalesTaxLineItem[]
  transactions          SalesTaxTransaction[]

  @@index([orderId])
  @@index([userId, createdAt])
  @@index([provider, providerCalculationId])
  @@index([provider, providerTransactionId])
  @@index([status])
  @@index([liabilityRole])
  @@map("sales_tax_calculations")
  @@schema("app")
}

model SalesTaxLineItem {
  id                    String                @id @default(uuid()) @db.Uuid

  salesTaxCalculationId String                @map("sales_tax_calculation_id") @db.Uuid
  offeringId            String?               @map("offering_id") @db.Uuid
  pricingTierId         String?               @map("pricing_tier_id") @db.Uuid

  itemType              SalesTaxLineItemType  @map("item_type")
  providerTaxCode       String?               @map("provider_tax_code")

  description           String?
  currency              String                @default("usd")
  amountCents           Int                   @map("amount_cents")
  taxAmountCents        Int                   @default(0) @map("tax_amount_cents")
  taxRatePercentage     Float?                @map("tax_rate_percentage")

  jurisdictionCountry   String?               @map("jurisdiction_country")
  jurisdictionState     String?               @map("jurisdiction_state")
  jurisdictionCounty    String?               @map("jurisdiction_county")
  jurisdictionCity      String?               @map("jurisdiction_city")

  metadata              Json?
  createdAt             DateTime              @default(now()) @map("created_at")

  salesTaxCalculation   SalesTaxCalculation   @relation(fields: [salesTaxCalculationId], references: [id], onDelete: Cascade)
  offering              Offering?             @relation("OfferingSalesTaxLineItems", fields: [offeringId], references: [id])
  pricingTier           PricingTier?          @relation("PricingTierSalesTaxLineItems", fields: [pricingTierId], references: [id])

  @@index([salesTaxCalculationId])
  @@index([offeringId])
  @@index([pricingTierId])
  @@index([itemType])
  @@map("sales_tax_line_items")
  @@schema("app")
}

model SalesTaxTransaction {
  id                    String                    @id @default(uuid()) @db.Uuid

  salesTaxCalculationId String?                   @map("sales_tax_calculation_id") @db.Uuid
  orderId               String                    @map("order_id") @db.Uuid
  userId                String?                   @map("user_id") @db.Uuid

  provider              SalesTaxProvider          @default(stripe_tax)
  status                SalesTaxTransactionStatus @default(pending)
  liabilityRole         SalesTaxLiabilityRole     @default(platform_marketplace_facilitator) @map("liability_role")

  providerTransactionId String?                   @map("provider_transaction_id")
  providerReversalId    String?                   @map("provider_reversal_id")

  currency              String                    @default("usd")
  taxAmountCents        Int                       @default(0) @map("tax_amount_cents")
  taxableAmountCents    Int                       @default(0) @map("taxable_amount_cents")

  recordedAt            DateTime?                 @map("recorded_at")
  reversedAt            DateTime?                 @map("reversed_at")
  failureReason         String?                   @map("failure_reason")
  metadata              Json?

  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  salesTaxCalculation   SalesTaxCalculation?      @relation(fields: [salesTaxCalculationId], references: [id])
  order                 Order                     @relation("OrderSalesTaxTransactions", fields: [orderId], references: [id])
  user                  User?                     @relation("UserSalesTaxTransactions", fields: [userId], references: [id])

  @@index([salesTaxCalculationId])
  @@index([orderId])
  @@index([userId, createdAt])
  @@index([provider, providerTransactionId])
  @@index([status])
  @@map("sales_tax_transactions")
  @@schema("app")
}

/**
 * =========================================================
 * CHILD-DIRECTED PRODUCT CONTROLS
 * Digital Goods Access owned, Identity & Access age gate referenced.
 * =========================================================
 */

model ChildDirectedContentDeclaration {
  id                    String                         @id @default(uuid()) @db.Uuid

  offeringId            String                         @map("offering_id") @db.Uuid
  digitalGoodsPolicyId  String?                        @map("digital_goods_policy_id") @db.Uuid
  declaredByUserId      String                         @map("declared_by_user_id") @db.Uuid
  reviewedByUserId      String?                        @map("reviewed_by_user_id") @db.Uuid

  status                ChildDirectedDeclarationStatus @default(not_declared)
  isChildDirected        Boolean                       @default(false) @map("is_child_directed")
  intendedMinimumAge     Int?                          @map("intended_minimum_age")
  intendedMaximumAge     Int?                          @map("intended_maximum_age")

  trackingCookiesDisabled Boolean                      @default(false) @map("tracking_cookies_disabled")
  targetedAdsDisabled     Boolean                      @default(false) @map("targeted_ads_disabled")
  publicCommentsDisabled  Boolean                      @default(false) @map("public_comments_disabled")

  declarationTextHash   String?                        @map("declaration_text_hash")
  adminNote             String?                        @map("admin_note")

  declaredAt            DateTime                       @default(now()) @map("declared_at")
  reviewedAt            DateTime?                      @map("reviewed_at")
  createdAt             DateTime                       @default(now()) @map("created_at")
  updatedAt             DateTime                       @updatedAt @map("updated_at")

  offering              Offering                       @relation("OfferingChildDirectedDeclarations", fields: [offeringId], references: [id], onDelete: Cascade)
  digitalGoodsPolicy    DigitalGoodsPolicy?            @relation(fields: [digitalGoodsPolicyId], references: [id])
  declaredByUser        User                           @relation("DeclaredChildDirectedContent", fields: [declaredByUserId], references: [id])
  reviewedByUser        User?                          @relation("ReviewedChildDirectedContent", fields: [reviewedByUserId], references: [id])
  privacyControls       MinorPrivacyControl[]

  @@index([offeringId, declaredAt])
  @@index([status])
  @@index([isChildDirected])
  @@index([declaredByUserId])
  @@index([reviewedByUserId])
  @@map("child_directed_content_declarations")
  @@schema("app")
}

model MinorPrivacyControl {
  id                              String   @id @default(uuid()) @db.Uuid

  childDirectedDeclarationId       String?  @map("child_directed_declaration_id") @db.Uuid
  offeringId                       String?  @map("offering_id") @db.Uuid

  targetType                       String   @map("target_type")
  targetId                         String   @map("target_id") @db.Uuid

  trackingCookiesDisabled          Boolean  @default(false) @map("tracking_cookies_disabled")
  targetedAdsDisabled              Boolean  @default(false) @map("targeted_ads_disabled")
  publicCommentsDisabled           Boolean  @default(false) @map("public_comments_disabled")
  behavioralAnalyticsDisabled      Boolean  @default(false) @map("behavioral_analytics_disabled")

  reason                           String?
  appliedAt                        DateTime @default(now()) @map("applied_at")
  revokedAt                        DateTime? @map("revoked_at")

  createdAt                        DateTime @default(now()) @map("created_at")
  updatedAt                        DateTime @updatedAt @map("updated_at")

  childDirectedDeclaration          ChildDirectedContentDeclaration? @relation(fields: [childDirectedDeclarationId], references: [id])
  offering                         Offering? @relation("OfferingMinorPrivacyControls", fields: [offeringId], references: [id])

  @@index([childDirectedDeclarationId])
  @@index([offeringId])
  @@index([targetType, targetId])
  @@map("minor_privacy_controls")
  @@schema("app")
}

/**
 * =========================================================
 * COURSE ACCESSIBILITY ASSETS
 * Digital Goods Access owned.
 *
 * Captions/transcripts are not the video itself.
 * MediaAsset stores the file.
 * CourseAccessibilityAsset stores accessibility meaning.
 * =========================================================
 */

model CourseAccessibilityAsset {
  id                         String                   @id @default(uuid()) @db.Uuid

  offeringId                 String?                  @map("offering_id") @db.Uuid
  courseDetailsOfferingId    String?                  @map("course_details_offering_id") @db.Uuid
  courseVideoAssetId         String?                  @map("course_video_asset_id") @db.Uuid
  mediaAssetId               String?                  @map("media_asset_id") @db.Uuid
  uploadedByUserId           String?                  @map("uploaded_by_user_id") @db.Uuid
  reviewedByUserId           String?                  @map("reviewed_by_user_id") @db.Uuid

  type                       AccessibilityAssetType
  status                     AccessibilityAssetStatus @default(uploaded)

  languageCode               String?                  @map("language_code")
  label                      String?
  isRequired                 Boolean                  @default(false) @map("is_required")
  isDefault                  Boolean                  @default(false) @map("is_default")

  providerReferenceId        String?                  @map("provider_reference_id")
  failureReason              String?                  @map("failure_reason")
  reviewNote                 String?                  @map("review_note")

  uploadedAt                 DateTime?                @map("uploaded_at")
  readyAt                    DateTime?                @map("ready_at")
  reviewedAt                 DateTime?                @map("reviewed_at")
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")

  offering                   Offering?                @relation("OfferingCourseAccessibilityAssets", fields: [offeringId], references: [id])
  courseDetails              CourseDetails?           @relation("CourseDetailsAccessibilityAssets", fields: [courseDetailsOfferingId], references: [offeringId])
  courseVideoAsset           CourseVideoAsset?         @relation("CourseVideoAccessibilityAssets", fields: [courseVideoAssetId], references: [id])
  mediaAsset                 MediaAsset?              @relation("CourseAccessibilityMediaAsset", fields: [mediaAssetId], references: [id])
  uploadedByUser             User?                    @relation("UploadedCourseAccessibilityAssets", fields: [uploadedByUserId], references: [id])
  reviewedByUser             User?                    @relation("ReviewedCourseAccessibilityAssets", fields: [reviewedByUserId], references: [id])

  @@index([offeringId])
  @@index([courseDetailsOfferingId])
  @@index([courseVideoAssetId])
  @@index([mediaAssetId])
  @@index([type, status])
  @@index([languageCode])
  @@map("course_accessibility_assets")
  @@schema("app")
}

/*********
 * =========================================================
 * TRACKING & ENTITLEMENTS
 *
 * TrackSubscription = recurring subscription access.
 * TrackEntitlementGrant = non-recurring access grant.
 * TrackUsageEvent = usage event for tracking/analytics.
 * =========================================================
 */


model TrackPlan {
  id                  String            @id @default(uuid()) @db.Uuid

  track               AccountTrack
  key                 String
  name                String
  status              TrackPlanStatus   @default(draft)
  billingModel        TrackBillingModel @map("billing_model")

  monthlyPriceCents   Int?              @map("monthly_price_cents")
  currency            String            @default("usd")

  description         String?
  displayOrder        Int               @default(0) @map("display_order")
  metadata            Json?

  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  prices              TrackPlanPrice[]
  planEntitlements    TrackPlanEntitlement[]
  subscriptions       TrackSubscription[]
  events              TrackSubscriptionEvent[]

  @@unique([track, key])
  @@index([track, status])
  @@map("track_plans")
  @@schema("app")
}

model TrackPlanPrice {
  id                    String               @id @default(uuid()) @db.Uuid
  planId                String               @map("plan_id") @db.Uuid

  provider              TrackBillingProvider @default(stripe)
  providerPriceId       String?              @map("provider_price_id")
  providerProductId     String?              @map("provider_product_id")

  amountCents           Int?                 @map("amount_cents")
  currency              String               @default("usd")
  interval              TrackUsagePeriod?    // usually monthly/yearly

  isActive              Boolean              @default(true) @map("is_active")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  plan                  TrackPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, isActive])
  @@index([provider, providerPriceId])
  @@map("track_plan_prices")
  @@schema("app")
}

model TrackEntitlementDefinition {
  id              String                    @id @default(uuid()) @db.Uuid

  key             String                    @unique
  label           String
  description     String?
  valueType       TrackEntitlementValueType @map("value_type")

  track           AccountTrack?
  isActive        Boolean                   @default(true) @map("is_active")

  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  planEntitlements TrackPlanEntitlement[]
  grants           TrackEntitlementGrant[]
  usageEvents      TrackUsageEvent[]
  usageCounters    TrackUsageCounter[]

  @@index([track, isActive])
  @@map("track_entitlement_definitions")
  @@schema("app")
}

model TrackPlanEntitlement {
  id                  String                    @id @default(uuid()) @db.Uuid

  planId              String                    @map("plan_id") @db.Uuid
  entitlementId       String                    @map("entitlement_id") @db.Uuid

  valueType           TrackEntitlementValueType @map("value_type")
  booleanValue        Boolean?                  @map("boolean_value")
  intValue            Int?                      @map("int_value")
  decimalValue        Float?                    @map("decimal_value")
  stringValue         String?                   @map("string_value")
  jsonValue           Json?                     @map("json_value")

  usagePeriod         TrackUsagePeriod?         @map("usage_period")

  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  plan                TrackPlan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  entitlement         TrackEntitlementDefinition @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@unique([planId, entitlementId])
  @@index([entitlementId])
  @@map("track_plan_entitlements")
  @@schema("app")
}

model TrackSubscription {
  id                    String                  @id @default(uuid()) @db.Uuid

  userId                String                  @map("user_id") @db.Uuid
  planId                String                  @map("plan_id") @db.Uuid
  track                 AccountTrack

  customerProfileId     String?                 @map("customer_profile_id") @db.Uuid
  candidateProfileId    String?                 @map("candidate_profile_id") @db.Uuid
  professionalProfileId String?                 @map("professional_profile_id") @db.Uuid

  status                TrackSubscriptionStatus @default(active)

  provider              TrackBillingProvider    @default(stripe)
  providerCustomerId    String?                 @map("provider_customer_id")
  providerSubscriptionId String?                @map("provider_subscription_id")
  providerPriceId       String?                 @map("provider_price_id")

  currentPeriodStart    DateTime?               @map("current_period_start")
  currentPeriodEnd      DateTime?               @map("current_period_end")
  trialEndsAt           DateTime?               @map("trial_ends_at")
  cancelledAt           DateTime?               @map("cancelled_at")
  endedAt               DateTime?               @map("ended_at")

  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  user                  User                    @relation(fields: [userId], references: [id])
  plan                  TrackPlan               @relation(fields: [planId], references: [id])

  customerProfile       CustomerProfile?        @relation(fields: [customerProfileId], references: [id])
  candidateProfile      CandidateProfile?       @relation(fields: [candidateProfileId], references: [id])
  professionalProfile   ProfessionalProfile?    @relation(fields: [professionalProfileId], references: [id])

  entitlementGrants     TrackEntitlementGrant[]
  usageEvents           TrackUsageEvent[]
  usageCounters         TrackUsageCounter[]
  events                TrackSubscriptionEvent[]

  @@index([userId, track, status])
  @@index([planId])
  @@index([customerProfileId])
  @@index([candidateProfileId])
  @@index([professionalProfileId])
  @@index([provider, providerSubscriptionId])
  @@index([currentPeriodEnd])
  @@map("track_subscriptions")
  @@schema("app")
}

model TrackEntitlementGrant {
  id                    String                      @id @default(uuid()) @db.Uuid

  userId                String                      @map("user_id") @db.Uuid
  subscriptionId        String?                     @map("subscription_id") @db.Uuid
  entitlementId         String                      @map("entitlement_id") @db.Uuid
  track                 AccountTrack

  customerProfileId     String?                     @map("customer_profile_id") @db.Uuid
  candidateProfileId    String?                     @map("candidate_profile_id") @db.Uuid
  professionalProfileId String?                     @map("professional_profile_id") @db.Uuid

  status                TrackEntitlementGrantStatus @default(active)

  valueType             TrackEntitlementValueType   @map("value_type")
  booleanValue          Boolean?                    @map("boolean_value")
  intValue              Int?                        @map("int_value")
  decimalValue          Float?                      @map("decimal_value")
  stringValue           String?                     @map("string_value")
  jsonValue             Json?                       @map("json_value")

  startsAt              DateTime?                   @map("starts_at")
  expiresAt             DateTime?                   @map("expires_at")
  revokedAt             DateTime?                   @map("revoked_at")
  revokeReason          String?                     @map("revoke_reason")

  sourcePlanId          String?                     @map("source_plan_id") @db.Uuid
  sourceEventId         String?                     @map("source_event_id") @db.Uuid

  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  user                  User                        @relation(fields: [userId], references: [id])
  subscription          TrackSubscription?          @relation(fields: [subscriptionId], references: [id])
  entitlement           TrackEntitlementDefinition  @relation(fields: [entitlementId], references: [id])
  customerProfile       CustomerProfile?            @relation(fields: [customerProfileId], references: [id])
  candidateProfile      CandidateProfile?           @relation(fields: [candidateProfileId], references: [id])
  professionalProfile   ProfessionalProfile?        @relation(fields: [professionalProfileId], references: [id])

  usageEvents           TrackUsageEvent[]
  usageCounters         TrackUsageCounter[]

  @@index([userId, track, status])
  @@index([subscriptionId])
  @@index([entitlementId, status])
  @@index([customerProfileId, status])
  @@index([candidateProfileId, status])
  @@index([professionalProfileId, status])
  @@index([expiresAt])
  @@map("track_entitlement_grants")
  @@schema("app")
}

model TrackUsageEvent {
  id                    String                 @id @default(uuid()) @db.Uuid

  userId                String                 @map("user_id") @db.Uuid
  subscriptionId        String?                @map("subscription_id") @db.Uuid
  entitlementGrantId    String?                @map("entitlement_grant_id") @db.Uuid
  entitlementId         String?                @map("entitlement_id") @db.Uuid

  track                 AccountTrack
  type                  TrackUsageEventType

  customerProfileId     String?                @map("customer_profile_id") @db.Uuid
  candidateProfileId    String?                @map("candidate_profile_id") @db.Uuid
  professionalProfileId String?                @map("professional_profile_id") @db.Uuid

  targetType            String?                @map("target_type")
  targetId              String?                @map("target_id") @db.Uuid

  quantity              Int                    @default(1)
  occurredAt            DateTime               @default(now()) @map("occurred_at")
  metadata              Json?

  user                  User                   @relation(fields: [userId], references: [id])
  subscription          TrackSubscription?     @relation(fields: [subscriptionId], references: [id])
  entitlementGrant      TrackEntitlementGrant? @relation(fields: [entitlementGrantId], references: [id])
  entitlement           TrackEntitlementDefinition? @relation(fields: [entitlementId], references: [id])

  customerProfile       CustomerProfile?       @relation(fields: [customerProfileId], references: [id])
  candidateProfile      CandidateProfile?      @relation(fields: [candidateProfileId], references: [id])
  professionalProfile   ProfessionalProfile?   @relation(fields: [professionalProfileId], references: [id])

  @@index([userId, type, occurredAt])
  @@index([candidateProfileId, type, occurredAt])
  @@index([customerProfileId, type, occurredAt])
  @@index([professionalProfileId, type, occurredAt])
  @@index([targetType, targetId])
  @@map("track_usage_events")
  @@schema("app")
}

model TrackUsageCounter {
  id                    String                    @id @default(uuid()) @db.Uuid

  userId                String                    @map("user_id") @db.Uuid
  subscriptionId        String?                   @map("subscription_id") @db.Uuid
  entitlementGrantId    String?                   @map("entitlement_grant_id") @db.Uuid
  entitlementId         String                    @map("entitlement_id") @db.Uuid

  track                 AccountTrack
  period                TrackUsagePeriod

  customerProfileId     String?                   @map("customer_profile_id") @db.Uuid
  candidateProfileId    String?                   @map("candidate_profile_id") @db.Uuid
  professionalProfileId String?                   @map("professional_profile_id") @db.Uuid

  periodStart           DateTime                  @map("period_start")
  periodEnd             DateTime                  @map("period_end")

  usedQuantity          Int                       @default(0) @map("used_quantity")
  limitQuantity         Int?                      @map("limit_quantity")

  updatedAt             DateTime                  @updatedAt @map("updated_at")
  createdAt             DateTime                  @default(now()) @map("created_at")

  user                  User                      @relation(fields: [userId], references: [id])
  subscription          TrackSubscription?        @relation(fields: [subscriptionId], references: [id])
  entitlementGrant      TrackEntitlementGrant?    @relation(fields: [entitlementGrantId], references: [id])
  entitlement           TrackEntitlementDefinition @relation(fields: [entitlementId], references: [id])

  customerProfile       CustomerProfile?          @relation(fields: [customerProfileId], references: [id])
  candidateProfile      CandidateProfile?         @relation(fields: [candidateProfileId], references: [id])
  professionalProfile   ProfessionalProfile?      @relation(fields: [professionalProfileId], references: [id])

  @@unique([entitlementId, track, userId, periodStart, periodEnd])
  @@index([candidateProfileId, periodStart, periodEnd])
  @@index([customerProfileId, periodStart, periodEnd])
  @@index([professionalProfileId, periodStart, periodEnd])
  @@map("track_usage_counters")
  @@schema("app")
}

model TrackSubscriptionEvent {
  id              String             @id @default(uuid()) @db.Uuid
  subscriptionId  String?            @map("subscription_id") @db.Uuid
  planId          String?            @map("plan_id") @db.Uuid
  userId          String             @map("user_id") @db.Uuid

  name            String
  fromStatus      TrackSubscriptionStatus? @map("from_status")
  toStatus        TrackSubscriptionStatus? @map("to_status")

  provider        TrackBillingProvider?
  providerEventId String?            @map("provider_event_id")

  metadata        Json?
  createdAt       DateTime           @default(now()) @map("created_at")

  subscription    TrackSubscription? @relation(fields: [subscriptionId], references: [id])
  plan            TrackPlan?         @relation(fields: [planId], references: [id])
  user            User               @relation(fields: [userId], references: [id])

  @@index([subscriptionId, createdAt])
  @@index([planId])
  @@index([userId, createdAt])
  @@index([provider, providerEventId])
  @@map("track_subscription_events")
  @@schema("app")
}
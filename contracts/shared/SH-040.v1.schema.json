{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workin-ants:SH-040:v1",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-040.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "correlationId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "input": {
          "type": "object",
          "properties": {
            "signalId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "groupingPolicy": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            },
            "severity": {
              "type": "string",
              "enum": [
                "info",
                "warning",
                "critical"
              ]
            },
            "source": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Target"
            },
            "transition": {
              "type": "string",
              "enum": [
                "open",
                "triage",
                "mitigate",
                "resolve",
                "reopen"
              ]
            },
            "expectedRevision": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Token"
            }
          },
          "required": [
            "signalId",
            "groupingPolicy",
            "severity",
            "source",
            "transition",
            "expectedRevision"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "requestId",
        "correlationId",
        "input"
      ],
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-040.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "status": {
          "const": "ok"
        },
        "value": {
          "type": "object",
          "properties": {
            "incidentId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "status": {
              "type": "string",
              "enum": [
                "open",
                "triaged",
                "mitigated",
                "resolved"
              ]
            },
            "receipt": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Receipt"
            }
          },
          "required": [
            "incidentId",
            "status",
            "receipt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "requestId",
        "status",
        "value"
      ],
      "additionalProperties": false
    },
    "rejected": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-040.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "status": {
          "enum": [
            "denied",
            "not_found",
            "stale",
            "conflict",
            "unsupported",
            "unavailable",
            "invalid"
          ]
        },
        "reasonCode": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Key"
        },
        "retryable": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Bool"
        },
        "safeMessageKey": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Key"
        }
      },
      "required": [
        "contract",
        "requestId",
        "status",
        "reasonCode",
        "retryable",
        "safeMessageKey"
      ],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "SH-040.v1"
            },
            "requestId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "status": {
              "const": "ok"
            },
            "value": {
              "type": "object",
              "properties": {
                "incidentId": {
                  "$ref": "urn:workin-ants:types:v1#/$defs/Id"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "open",
                    "triaged",
                    "mitigated",
                    "resolved"
                  ]
                },
                "receipt": {
                  "$ref": "urn:workin-ants:types:v1#/$defs/Receipt"
                }
              },
              "required": [
                "incidentId",
                "status",
                "receipt"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "contract",
            "requestId",
            "status",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "SH-040.v1"
            },
            "requestId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "status": {
              "enum": [
                "denied",
                "not_found",
                "stale",
                "conflict",
                "unsupported",
                "unavailable",
                "invalid"
              ]
            },
            "reasonCode": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            },
            "retryable": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Bool"
            },
            "safeMessageKey": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            }
          },
          "required": [
            "contract",
            "requestId",
            "status",
            "reasonCode",
            "retryable",
            "safeMessageKey"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workin-ants:SH-125:v1",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-125.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "correlationId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "input": {
          "type": "object",
          "properties": {
            "variant": {
              "enum": [
                "digital_goods_access.recordDomainAccessEvent.v1",
                "media_file_access.recordDomainAccessEvent.v1",
                "video_session.recordDomainAccessEvent.v1",
                "candidate_application_resume_privacy.recordDomainAccessEvent.v1",
                "messaging.recordDomainAccessEvent.v1",
                "transaction_order.recordDomainAccessEvent.v1",
                "privacy_data_erasure.recordDomainAccessEvent.v1"
              ]
            },
            "context": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Target"
            },
            "action": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            },
            "reason": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            },
            "resourceVersion": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Token"
            },
            "grantRef": {
              "$ref": "urn:workin-ants:types:v1#/$defs/MaybeId"
            },
            "providerReceipt": {
              "$ref": "urn:workin-ants:types:v1#/$defs/MaybeId"
            },
            "semanticKey": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            }
          },
          "required": [
            "variant",
            "context",
            "action",
            "reason",
            "resourceVersion",
            "grantRef",
            "providerReceipt",
            "semanticKey"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "requestId",
        "correlationId",
        "input"
      ],
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-125.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "status": {
          "const": "ok"
        },
        "value": {
          "type": "object",
          "properties": {
            "accessEvent": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "receipt": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Receipt"
            }
          },
          "required": [
            "accessEvent",
            "receipt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "requestId",
        "status",
        "value"
      ],
      "additionalProperties": false
    },
    "rejected": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-125.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "status": {
          "enum": [
            "denied",
            "not_found",
            "stale",
            "conflict",
            "unsupported",
            "unavailable",
            "invalid"
          ]
        },
        "reasonCode": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Key"
        },
        "retryable": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Bool"
        },
        "safeMessageKey": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Key"
        }
      },
      "required": [
        "contract",
        "requestId",
        "status",
        "reasonCode",
        "retryable",
        "safeMessageKey"
      ],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "SH-125.v1"
            },
            "requestId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "status": {
              "const": "ok"
            },
            "value": {
              "type": "object",
              "properties": {
                "accessEvent": {
                  "$ref": "urn:workin-ants:types:v1#/$defs/Id"
                },
                "receipt": {
                  "$ref": "urn:workin-ants:types:v1#/$defs/Receipt"
                }
              },
              "required": [
                "accessEvent",
                "receipt"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "contract",
            "requestId",
            "status",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "SH-125.v1"
            },
            "requestId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "status": {
              "enum": [
                "denied",
                "not_found",
                "stale",
                "conflict",
                "unsupported",
                "unavailable",
                "invalid"
              ]
            },
            "reasonCode": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            },
            "retryable": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Bool"
            },
            "safeMessageKey": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            }
          },
          "required": [
            "contract",
            "requestId",
            "status",
            "reasonCode",
            "retryable",
            "safeMessageKey"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ]
}

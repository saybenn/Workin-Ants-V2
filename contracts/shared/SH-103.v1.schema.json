{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workin-ants:SH-103:v1",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-103.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "correlationId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "input": {
          "type": "object",
          "properties": {
            "variant": {
              "enum": [
                "professional_eligibility.executeModerationDecision.v1",
                "marketplace_supply.executeModerationDecision.v1",
                "gig_demand.executeModerationDecision.v1",
                "organization_hiring.executeModerationDecision.v1",
                "candidate_application_resume_privacy.executeModerationDecision.v1",
                "media_file_access.executeModerationDecision.v1",
                "video_session.executeModerationDecision.v1",
                "digital_goods_access.executeModerationDecision.v1",
                "messaging.executeModerationDecision.v1",
                "search_public_visibility.executeModerationDecision.v1",
                "review_dispute.executeModerationDecision.v1"
              ]
            },
            "decision": {
              "$ref": "urn:workin-ants:types:v1#/$defs/ModerationInstruction"
            },
            "expectedTargetToken": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Token"
            },
            "semanticKey": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            }
          },
          "required": [
            "variant",
            "decision",
            "expectedTargetToken",
            "semanticKey"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "requestId",
        "correlationId",
        "input"
      ],
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-103.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "status": {
          "const": "ok"
        },
        "value": {
          "type": "object",
          "properties": {
            "execution": {
              "$ref": "urn:workin-ants:types:v1#/$defs/ModerationExecution"
            }
          },
          "required": [
            "execution"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "requestId",
        "status",
        "value"
      ],
      "additionalProperties": false
    },
    "rejected": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-103.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "status": {
          "enum": [
            "denied",
            "not_found",
            "stale",
            "conflict",
            "unsupported",
            "unavailable",
            "invalid"
          ]
        },
        "reasonCode": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Key"
        },
        "retryable": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Bool"
        },
        "safeMessageKey": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Key"
        }
      },
      "required": [
        "contract",
        "requestId",
        "status",
        "reasonCode",
        "retryable",
        "safeMessageKey"
      ],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "SH-103.v1"
            },
            "requestId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "status": {
              "const": "ok"
            },
            "value": {
              "type": "object",
              "properties": {
                "execution": {
                  "$ref": "urn:workin-ants:types:v1#/$defs/ModerationExecution"
                }
              },
              "required": [
                "execution"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "contract",
            "requestId",
            "status",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "SH-103.v1"
            },
            "requestId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "status": {
              "enum": [
                "denied",
                "not_found",
                "stale",
                "conflict",
                "unsupported",
                "unavailable",
                "invalid"
              ]
            },
            "reasonCode": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            },
            "retryable": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Bool"
            },
            "safeMessageKey": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            }
          },
          "required": [
            "contract",
            "requestId",
            "status",
            "reasonCode",
            "retryable",
            "safeMessageKey"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ]
}

          "const": "SH-072.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "correlationId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "input": {
          "type": "object",
          "properties": {
            "canonicalBytes": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Bytes"
            },
            "purpose": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            },
            "canonicalizationVersion": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            },
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256",
                "hmac_sha256"
              ]
            },
            "keyRef": {
              "$ref": "urn:workin-ants:types:v1#/$defs/MaybeSecret"
            }
          },
          "required": [
            "canonicalBytes",
            "purpose",
            "canonicalizationVersion",
            "algorithm",
            "keyRef"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "requestId",
        "correlationId",
        "input"
      ],
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-072.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "status": {
          "const": "ok"
        },
        "value": {
          "type": "object",
          "properties": {
            "digest": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Digest"
            },
            "algorithm": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            },
            "keyVersion": {
              "$ref": "urn:workin-ants:types:v1#/$defs/MaybeKey"
            }
          },
          "required": [
            "digest",
            "algorithm",
            "keyVersion"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "requestId",
        "status",
        "value"
      ],
      "additionalProperties": false
    },
    "rejected": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-072.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "status": {
          "enum": [
            "denied",
            "not_found",
            "stale",
            "conflict",
            "unsupported",
            "unavailable",
            "invalid"
          ]
        },
        "reasonCode": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Key"
        },
        "retryable": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Bool"
        },
        "safeMessageKey": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Key"
        }
      },
      "required": [
        "contract",
        "requestId",
        "status",
        "reasonCode",
        "retryable",
        "safeMessageKey"
      ],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "SH-072.v1"
            },
            "requestId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"

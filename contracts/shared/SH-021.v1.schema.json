{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workin-ants:SH-021:v1",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-021.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "correlationId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "input": {
          "type": "object",
          "properties": {
            "jobInput": {
              "$ref": "urn:workin-ants:types:v1#/$defs/JobInput"
            },
            "ruleSetRevision": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Token"
            },
            "evaluationPurpose": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            }
          },
          "required": [
            "jobInput",
            "ruleSetRevision",
            "evaluationPurpose"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "requestId",
        "correlationId",
        "input"
      ],
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-021.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "status": {
          "const": "ok"
        },
        "value": {
          "type": "object",
          "properties": {
            "decision": {
              "$ref": "urn:workin-ants:types:v1#/$defs/JobDecision"
            },
            "checkId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "inputDigest": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Digest"
            },
            "sourceToken": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Token"
            }
          },
          "required": [
            "decision",
            "checkId",
            "inputDigest",
            "sourceToken"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "requestId",
        "status",
        "value"
      ],
      "additionalProperties": false
    },
    "rejected": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-021.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "status": {
          "enum": [
            "denied",
            "not_found",
            "stale",
            "conflict",
            "unsupported",
            "unavailable",
            "invalid"
          ]
        },
        "reasonCode": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Key"
        },
        "retryable": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Bool"
        },
        "safeMessageKey": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Key"
        }
      },
      "required": [
        "contract",
        "requestId",
        "status",
        "reasonCode",
        "retryable",
        "safeMessageKey"
      ],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "SH-021.v1"
            },
            "requestId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "status": {
              "const": "ok"
            },
            "value": {
              "type": "object",
              "properties": {
                "decision": {
                  "$ref": "urn:workin-ants:types:v1#/$defs/JobDecision"
                },
                "checkId": {
                  "$ref": "urn:workin-ants:types:v1#/$defs/Id"
                },
                "inputDigest": {
                  "$ref": "urn:workin-ants:types:v1#/$defs/Digest"
                },
                "sourceToken": {
                  "$ref": "urn:workin-ants:types:v1#/$defs/Token"
                }
              },
              "required": [
                "decision",
                "checkId",
                "inputDigest",
                "sourceToken"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "contract",
            "requestId",
            "status",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "SH-021.v1"
            },
            "requestId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "status": {
              "enum": [
                "denied",
                "not_found",
                "stale",
                "conflict",
                "unsupported",
                "unavailable",
                "invalid"
              ]
            },
            "reasonCode": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            },
            "retryable": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Bool"
            },
            "safeMessageKey": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            }
          },
          "required": [
            "contract",
            "requestId",
            "status",
            "reasonCode",
            "retryable",
            "safeMessageKey"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ]
}

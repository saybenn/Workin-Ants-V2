{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workin-ants:SH-050:v1",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-050.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "correlationId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "input": {
          "type": "object",
          "properties": {
            "variant": {
              "enum": [
                "booking_calendar.reconcileWorkflowStatus.v1",
                "privacy_data_erasure.reconcileWorkflowStatus.v1",
                "content_moderation_legal_notice.reconcileWorkflowStatus.v1",
                "gamification_rewards.reconcileWorkflowStatus.v1",
                "sweepstakes_prize.reconcileWorkflowStatus.v1"
              ]
            },
            "run": {
              "$ref": "urn:workin-ants:types:v1#/$defs/WorkflowRun"
            },
            "requiredStepIds": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Strings"
            },
            "receipts": {
              "$ref": "urn:workin-ants:types:v1#/$defs/EffectReceipts"
            }
          },
          "required": [
            "variant",
            "run",
            "requiredStepIds",
            "receipts"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "requestId",
        "correlationId",
        "input"
      ],
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-050.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "status": {
          "const": "ok"
        },
        "value": {
          "type": "object",
          "properties": {
            "summary": {
              "$ref": "urn:workin-ants:types:v1#/$defs/WorkflowSummary"
            }
          },
          "required": [
            "summary"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "requestId",
        "status",
        "value"
      ],
      "additionalProperties": false
    },
    "rejected": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-050.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "status": {
          "enum": [
            "denied",
            "not_found",
            "stale",
            "conflict",
            "unsupported",
            "unavailable",
            "invalid"
          ]
        },
        "reasonCode": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Key"
        },
        "retryable": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Bool"
        },
        "safeMessageKey": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Key"
        }
      },
      "required": [
        "contract",
        "requestId",
        "status",
        "reasonCode",
        "retryable",
        "safeMessageKey"
      ],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "SH-050.v1"
            },
            "requestId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "status": {
              "const": "ok"
            },
            "value": {
              "type": "object",
              "properties": {
                "summary": {
                  "$ref": "urn:workin-ants:types:v1#/$defs/WorkflowSummary"
                }
              },
              "required": [
                "summary"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "contract",
            "requestId",
            "status",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "SH-050.v1"
            },
            "requestId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "status": {
              "enum": [
                "denied",
                "not_found",
                "stale",
                "conflict",
                "unsupported",
                "unavailable",
                "invalid"
              ]
            },
            "reasonCode": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            },
            "retryable": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Bool"
            },
            "safeMessageKey": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            }
          },
          "required": [
            "contract",
            "requestId",
            "status",
            "reasonCode",
            "retryable",
            "safeMessageKey"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ]
}

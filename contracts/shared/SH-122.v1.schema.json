{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workin-ants:SH-122:v1",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-122.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "correlationId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "input": {
          "type": "object",
          "properties": {
            "domainId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "duplicateTermId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "survivorTermId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "expectedRevision": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Token"
            },
            "mergePlan": {
              "$ref": "urn:workin-ants:types:v1#/$defs/TaxonomyMergePlan"
            },
            "phase": {
              "type": "string",
              "enum": [
                "preview",
                "execute"
              ]
            },
            "semanticKey": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            }
          },
          "required": [
            "domainId",
            "duplicateTermId",
            "survivorTermId",
            "expectedRevision",
            "mergePlan",
            "phase",
            "semanticKey"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "requestId",
        "correlationId",
        "input"
      ],
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-122.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "status": {
          "const": "ok"
        },
        "value": {
          "type": "object",
          "properties": {
            "merge": {
              "$ref": "urn:workin-ants:types:v1#/$defs/TaxonomyMergeResult"
            }
          },
          "required": [
            "merge"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "requestId",
        "status",
        "value"
      ],
      "additionalProperties": false
    },
    "rejected": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "SH-122.v1"
        },
        "requestId": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Id"
        },
        "status": {
          "enum": [
            "denied",
            "not_found",
            "stale",
            "conflict",
            "unsupported",
            "unavailable",
            "invalid"
          ]
        },
        "reasonCode": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Key"
        },
        "retryable": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Bool"
        },
        "safeMessageKey": {
          "$ref": "urn:workin-ants:types:v1#/$defs/Key"
        }
      },
      "required": [
        "contract",
        "requestId",
        "status",
        "reasonCode",
        "retryable",
        "safeMessageKey"
      ],
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "SH-122.v1"
            },
            "requestId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "status": {
              "const": "ok"
            },
            "value": {
              "type": "object",
              "properties": {
                "merge": {
                  "$ref": "urn:workin-ants:types:v1#/$defs/TaxonomyMergeResult"
                }
              },
              "required": [
                "merge"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "contract",
            "requestId",
            "status",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "SH-122.v1"
            },
            "requestId": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Id"
            },
            "status": {
              "enum": [
                "denied",
                "not_found",
                "stale",
                "conflict",
                "unsupported",
                "unavailable",
                "invalid"
              ]
            },
            "reasonCode": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            },
            "retryable": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Bool"
            },
            "safeMessageKey": {
              "$ref": "urn:workin-ants:types:v1#/$defs/Key"
            }
          },
          "required": [
            "contract",
            "requestId",
            "status",
            "reasonCode",
            "retryable",
            "safeMessageKey"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ]
}
